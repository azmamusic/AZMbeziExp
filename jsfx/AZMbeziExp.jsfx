desc:AZMbeziExp
tags:gate expander dynamics vocal

// カーブ編集型のフルバンド・ゲート/エキスパンダー（歌声向け試作）。
// 操作は @gfx のカスタム UI で行う。スライダーはすべて generic UI では隠してあるが、
// パラメーターとしては残してある（オートメーション等に使う想定）。
//
// Peak / RMS を Attack と Release で別々に混ぜ、上昇・下降に応じてカーブを選ぶ。
// 目標へのゲイン追随は dB 領域の Attack / Release 時間で平滑化する。

options:no_meter

// 先頭の "-" は generic UI で非表示にする指定（パラメーターとしては残る）。
// スライダー番号と並びは保存済みプロジェクトとの互換のため変えないこと（追加は末尾に）。
slider1:range_db=30<0,96,0.1>-Range (dB)
slider2:a_close=-70<-90,0,0.1>-Attack Curve Close (dB)
slider3:a_open=-60<-90,0,0.1>-Attack Curve Open (dB)
slider4:a_shape=50<-100,100,1>-Attack Curve Shape (%)
slider5:curve_sync=0<0,1,1{Off,On}>-Sync Attack/Release Curves
slider6:r_close=-65<-90,0,0.1>-Release Curve Close (dB)
slider7:r_open=-55<-90,0,0.1>-Release Curve Open (dB)
slider8:r_shape=-50<-100,100,1>-Release Curve Shape (%)
slider9:pk_sens=-3<-24,24,0.1>-Peak Sensitivity (dB)
slider10:pk_rel=10<1,500,1:log>-Legacy Peak Release (unused)
slider11:rms_sens=0<-24,24,0.1>-RMS Sensitivity (dB)
slider12:rms_time=20<1,200,1:log>-RMS Window (ms)
slider13:rms_rel=60<1,1000,1:log>-Legacy RMS Release (unused)
slider14:g_open=4<0.1,100,0.1:log>-Attack Time (ms)
slider15:g_close=80<0.1,500,0.1:log>-Release Time (ms)
slider16:meter_lo=-90<-90,-30,0.1>-Meter Min (dB)
slider17:meter_hi=0<-60,0,0.1>-Meter Max (dB)
slider18:fade_db=3<0,10,0.1>-Legacy Crossfade (unused)
slider19:attack_mix=0<0,100,1>-Attack RMS Ratio (%)
slider20:release_mix=100<0,100,1>-Release RMS Ratio (%)

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
gfx_ext_retina = 1; // HiDPI では gfx_w/gfx_h が実ピクセルになる

// 時定数(ms) → 1サンプルあたりの減衰係数
function decay_of(ms) (
  exp(-1 / max(ms * 0.001 * srate, 1));
);

// レベル(dB) → ゲイン(dB, 0以下)。
// Close..Open を 0..1 に正規化し、始点(0,0)・終点(1,1)・制御点(c,1-c) の
// 2次ベジェ曲線で写像する。c=0.5 で直線、c>0.5 で Open 付近まで閉じ気味、
// c<0.5 で早めに開く。x(u)=t を u について解いた式を使う。
function curve_db(lvl, close, span, c, range)
  local(t u)
(
  t = (lvl - close) / span;
  t <= 0 ? ( -range ) : (
    t >= 1 ? ( 0 ) : (
      u = t / (c + sqrt(c * c + (1 - 2 * c) * t));
      -range * (1 - (2 * u * (1 - u) * (1 - c) + u * u));
    );
  );
);

// 検知・ゲイン平滑の係数更新。
// Sync On の間は Release 側に Attack の値を使う（e_* が実際に使う Release カーブ）。
// r_* スライダーは書き換えない。
function update_coefs() (
  e_close = sync_on ? a_close : r_close;
  e_open = sync_on ? a_open : r_open;
  e_shape = sync_on ? a_shape : r_shape;
  a_span = max(a_open - a_close, 0.01);
  r_span = max(e_open - e_close, 0.01);
  a_c = 0.5 + 0.5 * min(max(a_shape * 0.01, -0.999), 0.999);
  r_c = 0.5 + 0.5 * min(max(e_shape * 0.01, -0.999), 0.999);

  pk_gain = exp(pk_sens * 0.11512925464970229);
  rms_gain = exp(rms_sens * 0.11512925464970229);
  rms_k = 1 - decay_of(rms_time);
  k_open = 1 - decay_of(g_open);
  k_close = 1 - decay_of(g_close);
  dir_k = 1 - decay_of(2);
  a_mix = min(max(attack_mix * 0.01, 0), 1);
  r_mix = min(max(release_mix * 0.01, 0), 1);
);

// Clamp both curves even when the bounds or curve parameters are automated.
function enforce_curve_bounds() local(lo hi b cl op ncl nop) (
  lo = min(max(meter_lo, -90), -30);
  hi = max(min(max(meter_hi, -60), 0), lo + 10);
  meter_lo != lo ? ( meter_lo = lo; sliderchange(slider16); );
  meter_hi != hi ? ( meter_hi = hi; sliderchange(slider17); );
  b = 2;
  loop(2,
    cl = slider(b); op = slider(b + 1);
    ncl = min(max(cl, lo), hi - 0.1);
    nop = min(max(op, lo + 0.1), hi);
    nop < ncl + 0.1 - 0.000000001 ? (
      ncl >= hi - 0.1 ? ( ncl = hi - 0.1; nop = hi; ) : ( nop = ncl + 0.1; );
    );
    ncl != cl ? ( slider(b) = ncl; sliderchange(slider(b)); );
    nop != op ? ( slider(b + 1) = nop; sliderchange(slider(b + 1)); );
    b = 6;
  );
);

// スライダー変更時の処理。@slider のほか、GUI 操作後の @block からも呼ぶ。
// GUI 側の sliderchange() で @slider が再実行されるかに依存しないよう、
// オーディオスレッドだけが係数更新を行う（@gfx はこの関数を呼ばない）。
function on_slider() (
  enforce_curve_bounds();
  sync_on = curve_sync >= 0.5;
  update_coefs();
);

// デノーマル回避用の下限（EEL2 では 1e-12 の指数表記が使えない）
floor_amp = pow(10, -12);
floor_pow = pow(10, -24);
eps_db = pow(10, -9);

msq = 0;
gain_init = 1;
gdb = 0;

// Direction uses a short slope detector so per-sample polarity flips do not
// immediately switch curves.
dir_up = 0;
dir_a_f = dir_r_f = 0;
prev_dir_a = prev_dir_r = 0;

// GUI との受け渡し用。m_* は @sample が前回描画以降の最大値を貯め、@gfx が読んで 0 に戻す。
// ui_dirty は @gfx が立て、@block が下ろす。
m_pk = 0;
m_rms = 0;
m_lin = 0;
ui_dirty = 0;

//==================== GUI (@gfx) ====================
// @gfx は @sample と別スレッドで動く。@sample が使う変数名
// (a, msq, pk_lin, rms_lin, lin, lvl_db, la, lr, tgt, dir_up, gain, gdb など) を
// 書き換えないこと。関数内の一時変数は必ず local() にする。
// DSP と共有してよいのは slider 変数・m_*・ui_dirty と、GR 表示のために読むだけの gdb。
// EEL2 の識別子は大文字小文字を区別しない（S と s は同じ）ので、S を使う関数に s という名前の引数は付けない。

ui_pk = ui_rms = ui_lvl = -120; // メーター表示値 (dB)
t_prev = time_precise();

BW = 800; BH = 520;  // 基準サイズ。実際の拡大率 S は gfx_w/gfx_h から求める

// パレット (0xRRGGBB)。白（窓の地）・紺（グラフの地、文字、つまみ）・山吹（Attack と、操作中の目印）の 3 色を基調にする。
// 色は平らに塗るだけで、グラデーションや影は使わない。山吹は目立つので、見せたいところにだけ使う。
C_BG = 0xFFFFFF; C_PANEL = 0xF3F5F9; C_TRACK = 0xDFE4EE; C_SLOT = 0xEEF1F7; C_RULE = 0xD5DBE8;
C_TEXT = 0x1F2E54; C_DIM = 0x5F6B8A; C_FAINT = 0x9AA4BC;
C_PLOT = 0x1F2E54; C_GRID = 0x30426F; C_GRID2 = 0x4A5E94;
C_YAM = 0xF0B13A; C_YAM2 = 0xF7C968; C_YAM3 = 0xDF9A22;
C_ATT = 0xF0B13A; C_REL = 0xFFFFFF; C_SYNC = 0xF0B13A; C_LIVE = 0xFFFFFF; C_GR = 0x1F2E54;

function clamp(x lim_lo lim_hi) ( x < lim_lo ? lim_lo : (x > lim_hi ? lim_hi : x) );
function rnd(x) ( floor(x + 0.5) );

function setc(col alpha) (
  gfx_set(((col >> 16) & 255) / 255, ((col >> 8) & 255) / 255, (col & 255) / 255, alpha);
);

// 端を丸めた座標で塗る（隣接矩形の隙間・重なりを防ぐ）
function frect(x y w h) local(x0 y0 x1 y1) (
  x0 = rnd(x); y0 = rnd(y); x1 = rnd(x + w); y1 = rnd(y + h);
  x1 > x0 && y1 > y0 ? gfx_rect(x0, y0, x1 - x0, y1 - y0);
);

// 角丸の塗り（gfx_roundrect は枠線のみのため自前）。不透明色専用。
// gfx_circle は中心±r を含む(2r+1 px)ので、半ピクセルずらして矩形の端に合わせる。
function rrect(x y w h r) (
  x = rnd(x); y = rnd(y); w = rnd(w); h = rnd(h);
  r = min(r, min(w, h) * 0.5);
  frect(x + r, y, w - 2 * r, h);
  frect(x, y + r, r, h - 2 * r);
  frect(x + w - r, y + r, r, h - 2 * r);
  gfx_circle(x + r - 0.5, y + r - 0.5, max(r - 0.5, 0.5), 1, 1);
  gfx_circle(x + w - r - 0.5, y + r - 0.5, max(r - 0.5, 0.5), 1, 1);
  gfx_circle(x + r - 0.5, y + h - r - 0.5, max(r - 0.5, 0.5), 1, 1);
  gfx_circle(x + w - r - 0.5, y + h - r - 0.5, max(r - 0.5, 0.5), 1, 1);
);

// 太さ th(px) のアンチエイリアス線（法線方向にずらした細線を重ねる）
function tline(x1 y1 x2 y2 th) local(dx dy l n j o) (
  th <= 1.2 ? gfx_line(x1, y1, x2, y2, 1) : (
    dx = x2 - x1; dy = y2 - y1;
    l = max(sqrt(dx * dx + dy * dy), 0.0001);
    n = ceil(th - 0.01);
    j = 0;
    loop(n,
      o = j - (n - 1) * 0.5;
      gfx_line(x1 - dy / l * o, y1 + dx / l * o, x2 - dy / l * o, y2 + dx / l * o, 1);
      j += 1;
    );
  );
);

// 太さ th(px) の丸い端の線。塗りつぶした円を密に並べるので、斜めでも太さが一定で縁がなめらか（不透明で引くときだけ）。
function sline(x0 y0 x1 y1 th) local(r l n k t) (
  r = th * 0.5;
  l = sqrt((x1 - x0) * (x1 - x0) + (y1 - y0) * (y1 - y0));
  n = max(ceil(l / max(r * 0.45, 0.8)), 1);
  k = 0;
  loop(n + 1,
    t = k / n;
    gfx_circle(x0 + (x1 - x0) * t, y0 + (y1 - y0) * t, r, 1, 1);
    k += 1;
  );
);

// 中心(cx,cy)・半径 r1〜r2・角度 a0〜a1(rad, 真上が 0・時計回りが正) の円弧の帯
function arcw(cx cy r1 r2 a0 a1) local(r) (
  a1 - a0 > 0.01 ? (
    r = r1;
    while (r <= r2 + 0.01) ( gfx_arc(cx, cy, r, a0, a1, 1); r += 0.5; );
  );
);

function font(id) local(sz fl) (
  sz = 12; fl = 0;
  id == 2 ? ( sz = 11; );
  id == 3 ? ( sz = 17; fl = 'b'; );
  id == 4 ? ( sz = 10; );
  id == 5 ? ( sz = 11; fl = 'b'; );
  id == 6 ? ( sz = 12; fl = 'b'; );
  id == 7 ? ( sz = lbl_fs / S; fl = 'b'; ); // つまみの名前（fit_labels が決めた大きさ）
  gfx_setfont(id, "Arial", max(rnd(sz * S), 6), fl);
);

// flags: 1=横中央 2=右寄せ 4=縦中央
function txt(msg x y w h fl) (
  gfx_x = x; gfx_y = y;
  gfx_drawstr(msg, fl, x + w, y + h);
);

// 小数 dec 桁の文字列（"-0.0" を避けるため先に丸める）
function fmt(v dec) local(p r) (
  p = 10 ^ dec;
  r = floor(abs(v) * p + 0.5) / p;
  v < 0 && r > 0 ? ( r = -r; );
  dec < 1 ? sprintf(#fmt, "%.0f", r) : (
    dec < 2 ? sprintf(#fmt, "%.1f", r) : sprintf(#fmt, "%.2f", r));
  #fmt;
);

// ---- パラメーター表（スライダー行の宣言と同じ値。5 番の Sync は別扱い） ----
// 0..4: 最小 最大 既定 刻み log / 5: 小数桁 / 6: 単位 / 7: 短い名前 / 8: 正式名 / 9: ヒント / 10: 0 中心のノブ
// GUI tables and hit-test rectangles occupy separate memory regions.
PT = 512;
function pdef(i mn mx df st lg dc unit nm fnm hnt bip) local(b) (
  b = PT + i * 12;
  b[0] = mn; b[1] = mx; b[2] = df; b[3] = st; b[4] = lg; b[5] = dc;
  b[6] = unit; b[7] = nm; b[8] = fnm; b[9] = hnt; b[10] = bip;
);
function pget(i f) local(b) ( b = PT + i * 12; b[f]; );

pdef(1, 0, 96, 30, 0.1, 0, 1, "dB", "Range", "Range", "Maximum attenuation when closed. Also sets the graph's gain axis", 0);
pdef(2, -90, 0, -70, 0.1, 0, 1, "dB", "Close", "Attack Close", "Used while the level rises. Fully closed at or below this level", 0);
pdef(3, -90, 0, -60, 0.1, 0, 1, "dB", "Open", "Attack Open", "Used while the level rises. Fully open (0 dB) at or above this level", 0);
pdef(4, -100, 100, 50, 1, 0, 0, "%", "Shape", "Attack Shape", "Bend of the rising-level curve. + stays closed longer, - opens earlier", 0);
pdef(6, -90, 0, -65, 0.1, 0, 1, "dB", "Close", "Release Close", "Used while the level falls. Fully closed at or below this level", 0);
pdef(7, -90, 0, -55, 0.1, 0, 1, "dB", "Open", "Release Open", "Used while the level falls. Fully open (0 dB) at or above this level", 0);
pdef(8, -100, 100, -50, 1, 0, 0, "%", "Shape", "Release Shape", "Bend of the falling-level curve. + stays closed longer, - opens earlier", 0);
pdef(9, -24, 24, -3, 0.1, 0, 1, "dB", "Peak Sens", "Peak Sensitivity", "Gain on the Peak detector. + opens on quieter sounds", 1);
pdef(11, -24, 24, 0, 0.1, 0, 1, "dB", "RMS Sens", "RMS Sensitivity", "Gain on the RMS detector. + opens on quieter sounds", 1);
pdef(12, 1, 200, 20, 1, 1, 0, "ms", "RMS Window", "RMS Window", "Averaging time of the RMS detector", 0);
pdef(14, 0.1, 100, 4, 0.1, 1, 1, "ms", "Time", "Attack Time", "Gain smoothing time while opening", 0);
pdef(15, 0.1, 500, 80, 0.1, 1, 1, "ms", "Time", "Release Time", "Gain smoothing time while closing", 0);
pdef(16, -90, -30, -90, 0.1, 0, 1, "dB", "Meter Min", "Meter Min", "Drag or click to edit. Narrowing clamps both curves", 0);
pdef(17, -60, 0, 0, 0.1, 0, 1, "dB", "Meter Max", "Meter Max", "Drag or click to edit. Narrowing clamps both curves", 0);
pdef(19, 0, 100, 0, 1, 0, 0, "%", "RMS Ratio", "Attack RMS Ratio", "0% follows Peak; 100% follows RMS", 0);
pdef(20, 0, 100, 100, 1, 0, 0, "%", "RMS Ratio", "Release RMS Ratio", "0% follows Peak; 100% follows RMS", 0);

function pq(i v) local(pmn pmx pst) (
  pmn = pget(i, 0); pmx = pget(i, 1); pst = pget(i, 3);
  clamp(floor((v - pmn) / pst + 0.5) * pst + pmn, pmn, pmx);
);
function p_norm(i v) local(pmn pmx) (
  pmn = pget(i, 0); pmx = pget(i, 1);
  pget(i, 4) ? log(max(v, pmn) / pmn) / log(pmx / pmn) : (v - pmn) / (pmx - pmn);
);
function p_from_norm(i n) local(pmn pmx) (
  pmn = pget(i, 0); pmx = pget(i, 1); n = clamp(n, 0, 1);
  pget(i, 4) ? pmn * exp(n * log(pmx / pmn)) : pmn + n * (pmx - pmn);
);

// GUI 側でスライダー値を書き換えたことを通知する。係数の再計算は @gfx では行わず、
// フラグだけ立てて @block（オーディオスレッド）で行う（関数のローカル変数がスレッド間で共有されるため）。
function notify(i) (
  sliderchange(slider(i));
  slider_automate(slider(i));
  ui_dirty = 1;
);

// パラメーター変更の窓口。Close < Open、Meter Min < Meter Max（10 dB 以上）を保つ。
function set_param(i v) local(old b cl op ncl nop lo hi) (
  (i == 2 || i == 6) ? ( v = min(v, slider(i + 1) - 0.1); );
  (i == 3 || i == 7) ? ( v = max(v, slider(i - 1) + 0.1); );
  (i == 2 || i == 3 || i == 6 || i == 7) ? ( v = clamp(v, meter_lo, meter_hi); );
  i == 16 ? ( v = min(v, slider(17) - 10); );
  i == 17 ? ( v = max(v, slider(16) + 10); );
  v = pq(i, v);
  old = slider(i);
  v != old ? (
    slider(i) = v; notify(i);
    (i == 16 || i == 17) ? (
      lo = meter_lo; hi = meter_hi; b = 2;
      loop(2,
        cl = slider(b); op = slider(b + 1);
        ncl = clamp(cl, lo, hi - 0.1); nop = clamp(op, lo + 0.1, hi);
        nop < ncl + 0.1 - 0.000000001 ? (
          ncl >= hi - 0.1 ? ( ncl = hi - 0.1; nop = hi; ) : ( nop = ncl + 0.1; );
        );
        ncl != cl ? ( slider(b) = ncl; notify(b); );
        nop != op ? ( slider(b + 1) = nop; notify(b + 1); );
        b = 6;
      );
    );
  );
);
function reset_param(i) ( set_param(i, pget(i, 2)); );

// Sync は Release の代わりに Attack を使うだけの一時モード。Release のスライダー値は触らない。
function set_sync(on) (
  slider(5) = on ? 1 : 0; notify(5);
  ui_sync = on;
);

// ホイール 1 ノッチ = つまみの移動量の 2%（Shift で 0.2%）。最低 1 ステップは動かす。
function wheel_param(i w) local(old v st) (
  old = slider(i); st = pget(i, 3);
  v = pq(i, p_from_norm(i, p_norm(i, old) + w * (shift ? 0.002 : 0.02)));
  abs(v - old) < st * 0.5 ? ( v = old + (w > 0 ? st : -st); );
  set_param(i, v);
);

// 直前のクリックと同じ対象への 2 回目ならダブルクリック
function is_dbl(id) local(d) (
  d = id == lc_id && now - lc_t < 0.4;
  lc_id = d ? 0 : id;
  lc_t = now;
  d;
);

// ---- 数値の直接入力（右クリックで開始） ----
function edit_commit() local(ok v) (
  edit_id ? (
    ok = edit_digits > 0 && match("%f", #edit_str, v);
    ok ? set_param(edit_id, v);
    edit_id = 0;
  );
);
function edit_begin(i) local(c) (
  edit_id ? edit_commit();
  c = 1;
  while (c > 0) ( c = gfx_getchar(); ); // 入力開始前に溜まっていたキーは捨てる
  edit_id = i;
  edit_t0 = now;
  strcpy(#edit_str, fmt(slider(i), pget(i, 5)));
  edit_digits = 1;
  edit_fresh = 1; // 最初の入力で全置換
);
function edit_key(c) local(n ch) (
  edit_t0 = now; // キャレットの点滅を押下時点から数え直す
  c == 13 || c == 10 ? ( edit_commit(); ) : (
  c == 27 ? ( edit_id = 0; ) : (
  c == 8 ? (
    edit_fresh ? ( strcpy(#edit_str, ""); edit_digits = 0; edit_fresh = 0; ) : (
      n = strlen(#edit_str);
      n > 0 ? (
        ch = str_getchar(#edit_str, n - 1);
        ch >= 48 && ch <= 57 ? ( edit_digits -= 1; );
        str_delsub(#edit_str, n - 1, 1);
      );
    );
  ) : (
    ch = c == 44 ? 46 : c; // ',' は '.' として扱う
    ((ch >= 48 && ch <= 57) || ch == 46 || ch == 45) && strlen(#edit_str) < 9 ? (
      edit_fresh ? ( strcpy(#edit_str, ""); edit_digits = 0; edit_fresh = 0; );
      ch >= 48 && ch <= 57 ? ( edit_digits += 1; );
      str_setchar(#edit_str, strlen(#edit_str), ch);
    );
  )));
);

// 入力中だけキー入力を受け取る（それ以外では gfx_getchar を呼ばず、キーは REAPER 側に任せる）
function ui_keys() local(c) (
  c = 1;
  while (edit_id && c != 0) (
    c = gfx_getchar();
    c < 0 ? ( edit_id = 0; ) : ( c > 0 ? edit_key(c); );
  );
);

// 入力欄。枠は山吹、文字は右寄せ。クリックで確定する範囲(edit_r*)もここで記録する。
function edit_box(x y w h) local(str tw th tx) (
  edit_rx = x; edit_ry = y; edit_rw = w; edit_rh = h;
  setc(C_YAM, 1); rrect(x, y, w, h, 5 * S);
  setc(C_BG, 1); rrect(x + 2 * S, y + 2 * S, w - 4 * S, h - 4 * S, 3.5 * S);
  font(1);
  str = #edit_str;
  gfx_measurestr(str, tw, th);
  tx = x + w - 8 * S - tw;
  edit_fresh ? ( setc(C_YAM, 0.4); frect(tx - 2 * S, y + 3.5 * S, tw + 4 * S, h - 7 * S); );
  setc(C_TEXT, 1);
  txt(str, tx, y, tw + 4 * S, h, 4);
  !edit_fresh && floor((now - edit_t0) * 2) % 2 == 0 ? ( setc(C_TEXT, 1); frect(x + w - 7 * S, y + 4 * S, max(S, 1), h - 8 * S); );
);

// ---- フレーム開始/終了 ----
// つまみの名前の文字サイズ lbl_fs。いちばん長い名前が隣と 4px ほど離れるように、窓が狭いときだけ小さくする。
function fit_labels() local(i tw th wmax fs) (
  font(5);
  wmax = 1;
  i = 1;
  loop(20,
    i == 1 || i == 9 || i == 11 || i == 12 || i == 14 || i == 15 || i == 19 || i == 20 ? (
      gfx_measurestr(pget(i, 7), tw, th); wmax = max(wmax, tw);
    );
    i += 1;
  );
  fs = max(rnd(11 * S), 6);
  lbl_fs = clamp(floor(fs * (kw - 4 * S) / wmax), 6, fs);
);

function ui_begin() local(v pad) (
  S = max(min(gfx_w / BW, gfx_h / BH), 0.25);
  now = time_precise();
  dt = clamp(now - t_prev, 0.001, 0.25);
  t_prev = now;

  mx = mouse_x; my = mouse_y;
  lmb = mouse_cap & 1;
  rmb = mouse_cap & 2;
  ldown = lmb && !lmb_prev;
  rdown = rmb && !rmb_prev;
  shift = mouse_cap & 8;
  ctrl = mouse_cap & 4;
  wh = mouse_wheel / 120;
  mouse_wheel = 0;
  !lmb && !(drag_id >= 416 && drag_id <= 417 && lmb_prev) ? ( drag_id = 0; );
  ui_sync = curve_sync >= 0.5;
  hint_id = 0;
  // 入力中の欄の外をクリックしたら、そのクリックを処理する前に確定する
  (ldown || rdown) && edit_id && !(mx >= edit_rx && mx < edit_rx + edit_rw && my >= edit_ry && my < edit_ry + edit_rh) ? edit_commit();
  ui_keys();

  // メーター: audio スレッドが貯めた最大値を取り込み、速い立ち上がり・遅い減衰で見せる
  v = m_pk; m_pk = 0;
  ui_pk = max(v > 0.000001 ? log(v) * 8.685889638065037 : -120, ui_pk - 45 * dt);
  v = m_rms; m_rms = 0;
  ui_rms = max(v > 0.000001 ? log(v) * 8.685889638065037 : -120, ui_rms - 45 * dt);
  v = m_lin; m_lin = 0;
  ui_lvl = max(v > 0.000001 ? log(v) * 8.685889638065037 : -120, ui_lvl - 45 * dt);

  // 表示するレベルの範囲（グラフの横軸とメーターで共通）と、ゲイン軸の範囲
  v_lo = clamp(meter_lo, -90, -30);
  v_hi = max(clamp(meter_hi, -60, 0), v_lo + 10);
  v_span = v_hi - v_lo;
  y_span = max(range_db, 1);

  // レイアウト（下から: フッター → つまみ → メーター → グラフ）
  mg = 14 * S;
  ft_h = 22 * S; ft_y = gfx_h - 8 * S - ft_h;
  kz_h = 92 * S; kz_y = ft_y - 6 * S - kz_h;
  gg = 16 * S;
  kw = (gfx_w - 2 * mg - 3 * gg) / 8;
  fit_labels();

  pl_x = mg + 34 * S;
  pl_y = 46 * S;
  pl_w = max(gfx_w - mg - 40 * S - pl_x, 60 * S);
  pl_b = max(kz_y - 54 * S, pl_y + 60 * S);
  pl_h = pl_b - pl_y;
  pad = 12 * S;
  g_x0 = pl_x + pad; g_w = pl_w - 2 * pad;
  g_y0 = pl_y + pad; g_h = pl_h - 2 * pad;
  clip_l = pl_x + S; clip_r = pl_x + pl_w - S;
  hit_r2 = (16 * S) * (16 * S);
);

function ui_end() (
  lmb_prev = lmb;
  rmb_prev = rmb;
);

// ---- グラフ ----
function xpix(db) ( g_x0 + (db - v_lo) * g_w / v_span; );
function ypix(g) ( g_y0 - g * g_h / y_span; );
function shape_c(sh) ( 0.5 + 0.5 * clamp(sh * 0.01, -0.999, 0.999); );

// 2次ベジェの正規化座標。x(u), y(u)（y は 0=閉, 1=開）と、y から u を求める逆変換。
function bz_x(u c) ( 2 * u * (1 - u) * c + u * u; );
function bz_y(u c) ( 2 * u * (1 - u) * (1 - c) + u * u; );
function bz_u(yn c) ( yn / ((1 - c) + sqrt((1 - c) * (1 - c) + (2 * c - 1) * yn)); );

// 横方向を clip_l〜clip_r に切り詰めて線を引く（gfx にクリップ機能がないため）。
// 太い線は塗りつぶした円を密に並べて引く（斜めでも太さが一定で、縁がなめらか）。水平な線は角のそろった長方形。
// 細い線（Sync 中に残す Release など、半透明で引く線）は重ねると濃くなるので tline を使う。
function cseg(x0 y0 x1 y1 th) local(t r l n k xx yy) (
  (x0 < clip_l && x1 < clip_l) || (x0 > clip_r && x1 > clip_r) ? 0 : (
    x0 < clip_l ? ( t = (clip_l - x0) / (x1 - x0); y0 += (y1 - y0) * t; x0 = clip_l; );
    x1 < clip_l ? ( t = (clip_l - x1) / (x0 - x1); y1 += (y0 - y1) * t; x1 = clip_l; );
    x0 > clip_r ? ( t = (x0 - clip_r) / (x0 - x1); y0 += (y1 - y0) * t; x0 = clip_r; );
    x1 > clip_r ? ( t = (x1 - clip_r) / (x1 - x0); y1 += (y0 - y1) * t; x1 = clip_r; );
    th > 3 * S ? (
      r = th * 0.5;
      abs(y1 - y0) < 0.01 ? (
        frect(min(x0, x1), rnd(y0 - r), abs(x1 - x0), max(rnd(y0 + r) - rnd(y0 - r), 1));
      ) : (
        l = sqrt((x1 - x0) * (x1 - x0) + (y1 - y0) * (y1 - y0));
        n = max(ceil(l / max(r * 0.45, 0.8)), 1);
        k = 0;
        loop(n + 1,
          t = k / n;
          xx = x0 + (x1 - x0) * t; yy = y0 + (y1 - y0) * t;
          xx >= clip_l + r && xx <= clip_r - r ? gfx_circle(xx, yy, r, 1, 1); // 枠にかかる円は描かない
          k += 1;
        );
      );
    ) : (
      tline(x0, y0, x1, y1, th);
    );
  );
);

function draw_grid() local(k x y raw step g dec every db first n) (
  // 紺のパネル（角丸）
  setc(C_PLOT, 1);
  rrect(pl_x, pl_y, pl_w, pl_h, 12 * S);

  // 縦線: 入力レベル。範囲に応じて 1/2/5/10/20 dB 刻み
  raw = v_span / 8;
  step = raw < 1.5 ? 1 : (raw < 3.5 ? 2 : (raw < 7.5 ? 5 : (raw < 15 ? 10 : 20)));
  every = g_w * step / v_span < 30 * S ? 2 : 1;
  font(4);
  first = ceil(v_lo / step - 0.0001);
  n = floor(v_span / step + 0.0001);
  k = 0;
  loop(n + 1,
    db = (first + k) * step;
    db <= v_hi + 0.001 ? (
      x = rnd(xpix(db));
      setc(abs(db) % 10 == 0 ? C_GRID2 : C_GRID, 1);
      gfx_line(x, pl_y + 2 * S, x, pl_b - 2 * S, 0);
      (first + k) % every == 0 && x > g_x0 + 80 * S && x < g_x0 + g_w - 80 * S ? (
        setc(C_DIM, 1);
        txt(fmt(db, 0), x - 20 * S, pl_b + 5 * S, 40 * S, 13 * S, 1);
      );
    );
    k += 1;
  );

  // 横線: ゲイン。読みやすい刻み(1/2/5 × 10^n)で 5 本前後
  raw = y_span / 5;
  step = 10 ^ floor(log10(raw));
  g = raw / step;
  step = (g < 1.5 ? 1 : (g < 3.5 ? 2 : (g < 7.5 ? 5 : 10))) * step;
  dec = step < 1 ? 1 : 0;
  g = 0;
  while (g <= y_span + 0.0001) (
    y = rnd(ypix(-g));
    setc(g == 0 ? C_GRID2 : C_GRID, 1);
    gfx_line(pl_x + 2 * S, y, pl_x + pl_w - 2 * S, y, 0);
    setc(C_DIM, 1);
    txt(fmt(-g, dec), pl_x - 44 * S, y - 7 * S, 36 * S, 14 * S, 2 | 4);
    g += step;
  );
);

// 曲線 b=2 (Attack) / 6 (Release) の折れ線。両端の水平部を含め、グラフの外には出さない。
function curve_path(b th) local(cl op c span u k x0 y0 x1 y1 yb yt) (
  cl = slider(b); op = slider(b + 1);
  span = max(op - cl, 0.01);
  c = shape_c(slider(b + 2));
  yb = ypix(-range_db); yt = ypix(0);
  x0 = xpix(cl); y0 = yb;
  cseg(clip_l, yb, x0, yb, th);
  cseg(xpix(op), yt, clip_r, yt, th);
  k = 0;
  loop(48,
    k += 1;
    u = k / 48;
    x1 = xpix(cl + bz_x(u, c) * span);
    y1 = ypix(-range_db * (1 - bz_y(u, c)));
    cseg(x0, y0, x1, y1, th);
    x0 = x1; y0 = y1;
  );
);

// 縁取りを敷いてから色線を引く（2本が交差しても見分けやすい）。縁取りはグラフの地と同じ色。
function draw_curve(b col th) (
  setc(C_PLOT, 1); curve_path(b, th + 3 * S);
  setc(col, 1); curve_path(b, th);
);

// Attack / Release のカーブの間を薄く塗る。
function draw_band() local(k n yt yb h ac rc asp rsp yn xa xr x1 x2) (
  yt = ypix(0); yb = ypix(-range_db);
  n = max(floor((yb - yt) / (2 * S)), 1);
  h = (yb - yt) / n;
  ac = shape_c(a_shape); rc = shape_c(r_shape);
  asp = max(a_open - a_close, 0.01); rsp = max(r_open - r_close, 0.01);
  setc(0xFFFFFF, 0.1);
  k = 0;
  loop(n,
    yn = 1 - (k + 0.5) / n;
    xa = xpix(a_close + bz_x(bz_u(yn, ac), ac) * asp);
    xr = xpix(r_close + bz_x(bz_u(yn, rc), rc) * rsp);
    x1 = max(min(xa, xr), clip_l); x2 = min(max(xa, xr), clip_r);
    x2 - x1 >= 1 ? ( frect(x1, yt + k * h, x2 - x1, h); );
    k += 1;
  );
);

// 現在の入力レベルとゲイン（白い点）。紺の縁を付けて、白や山吹の線の上でも見えるようにする。
function draw_live() local(x y) (
  x = xpix(clamp(ui_lvl, v_lo, v_hi));
  y = ypix(clamp(gdb, -y_span, 0));
  setc(C_LIVE, 0.2);
  gfx_line(x, pl_y + 2 * S, x, pl_b - 2 * S, 0);
  setc(C_PLOT, 1); gfx_circle(x, y, 7.4 * S, 1, 1);
  setc(C_LIVE, 1); gfx_circle(x, y, 4.8 * S, 1, 1);
);

// ハンドル ID = 100 + スライダー番号。位置を h_x, h_y に返す。表示範囲の外なら端に寄せ、h_off に -1/1 を返す。
function hpos(id) local(p b cl op c span) (
  p = id - 100;
  b = p < 5 ? 2 : 6;
  cl = slider(b); op = slider(b + 1);
  span = max(op - cl, 0.01);
  c = shape_c(slider(b + 2));
  p == b ? ( h_x = xpix(cl); h_y = ypix(-range_db); ) : (
    p == b + 1 ? ( h_x = xpix(op); h_y = ypix(0); ) : (
      h_x = xpix(cl + bz_x(0.5, c) * span);
      h_y = ypix(-range_db * (1 - bz_y(0.5, c)));
    )
  );
  h_off = h_x < g_x0 - 0.5 ? -1 : (h_x > g_x0 + g_w + 0.5 ? 1 : 0);
  h_x = clamp(h_x, g_x0, g_x0 + g_w);
);

// 形状ハンドルが動く線分の両端（c=0 と c=1 の中点）を sg_* に返す。
function hseg(b) local(cl op span) (
  cl = slider(b); op = slider(b + 1);
  span = max(op - cl, 0.01);
  sg_ax = xpix(cl + 0.25 * span); sg_ay = ypix(-range_db * 0.25);
  sg_bx = xpix(cl + 0.75 * span); sg_by = ypix(-range_db * 0.75);
);

function find_handle() local(i id best bd dx dy d) (
  best = 0; bd = hit_r2;
  i = 0;
  loop(ui_sync ? 3 : 6,
    id = 100 + (i < 3 ? 2 + i : 3 + i); // 102..104 = Attack, 106..108 = Release
    hpos(id);
    dx = mx - h_x; dy = my - h_y; d = dx * dx + dy * dy;
    d < bd ? ( bd = d; best = id; );
    i += 1;
  );
  best;
);

function drag_handle() local(p k dx dy dd t) (
  p = drag_id - 100;
  k = shift ? 0.1 : 1;
  shift != drag_sh ? ( // Shift の切替時は基準を取り直して値が飛ばないようにする
    drag_sh = shift;
    drag_mx0 = mx; drag_my0 = my; drag_v0 = slider(p);
  );
  p == 4 || p == 8 ? (
    hseg(p == 4 ? 2 : 6);
    dx = sg_bx - sg_ax; dy = sg_by - sg_ay;
    dd = max(dx * dx + dy * dy, 1);
    t = 0.5 + drag_v0 * 0.005 + k * ((mx - drag_mx0) * dx + (my - drag_my0) * dy) / dd;
    set_param(p, (t - 0.5) * 200);
  ) : (
    set_param(p, drag_v0 + k * (mx - drag_mx0) * v_span / g_w);
  );
);

HP = 920; // 各ハンドルの描画位置（HP[p*2], HP[p*2+1]）。テスト用にも使う
function draw_handles() local(i id p b col hot r al) (
  i = 0;
  loop(ui_sync ? 3 : 6,
    id = 100 + (i < 3 ? 2 + i : 3 + i);
    p = id - 100;
    b = p < 5 ? 2 : 6;
    hot = hov_h == id || drag_id == id;
    hpos(id);
    HP[p * 2] = h_x; HP[p * 2 + 1] = h_y;
    al = h_off ? 0.5 : 1;
    col = ui_sync ? C_SYNC : (b == 2 ? C_ATT : C_REL);
    p == b + 2 ? (
      // 形状ハンドル: 曲線と同じ色の輪（中は紺）。つかむと塗りつぶす
      r = (hot ? 10 : 8.5) * S;
      hot ? ( setc(col, 0.2); gfx_circle(h_x, h_y, r + 4.5 * S, 1, 1); );
      setc(C_PLOT, al); gfx_circle(h_x, h_y, r + 2.5 * S, 1, 1);
      setc(col, al); gfx_circle(h_x, h_y, r, 1, 1);
      drag_id != id ? ( setc(C_PLOT, 1); gfx_circle(h_x, h_y, r - 3.4 * S, 1, 1); );
      drag_id != id && !h_off ? ( setc(col, 1); gfx_circle(h_x, h_y, 2.4 * S, 1, 1); );
    ) : (
      // Close / Open: 曲線と同じ色の点（紺の縁つき）。表示範囲の外にあるものは端に寄せ、薄い輪にする
      r = (hot ? 9.5 : 8) * S;
      hot ? ( setc(col, 0.2); gfx_circle(h_x, h_y, r + 5 * S, 1, 1); );
      setc(C_PLOT, al); gfx_circle(h_x, h_y, r + 2.5 * S, 1, 1);
      setc(col, al); gfx_circle(h_x, h_y, r, 1, 1);
      h_off && drag_id != id ? ( setc(C_PLOT, 1); gfx_circle(h_x, h_y, r - 3.2 * S, 1, 1); );
    );
    i += 1;
  );
);

// ハンドルの吹き出し。ホバー中は値を表示し、入力中は入力欄を出す。
function draw_tip() local(p w h x y tw th ed bw nmw vw) (
  ed = edit_id && (edit_id < 5 || (edit_id > 5 && edit_id < 9));
  p = ed ? edit_id : hov_h - 100;
  strcpy(#tipn, ui_sync ? pget(p, 7) : pget(p, 8));
  font(2);
  gfx_measurestr(#tipn, nmw, th);
  strcpy(#tip, fmt(slider(p), pget(p, 5)));
  strcat(#tip, " ");
  strcat(#tip, pget(p, 6));
  gfx_measurestr(#tip, vw, th);
  h = 24 * S;
  bw = ed ? 70 * S : vw;
  w = nmw + bw + 28 * S;
  hpos(100 + p);
  x = clamp(h_x + 16 * S, pl_x + 4 * S, pl_x + pl_w - w - 4 * S);
  y = clamp(h_y - h - 16 * S, pl_y + 4 * S, pl_b - h - 4 * S);
  setc(C_BG, 1); rrect(x, y, w, h, 7 * S);
  setc(C_DIM, 1); txt(#tipn, x + 10 * S, y, nmw + 4 * S, h, 4);
  ed ? (
    edit_box(x + 16 * S + nmw, y + 3 * S, bw, h - 6 * S);
  ) : (
    setc(C_TEXT, 1); txt(#tip, x + 18 * S + nmw, y, vw + 4 * S, h, 4);
  );
);

// Click a bound to type; dragging changes it at 0.1 dB per 2 pixels.
function ui_bound(i x y w h) local(hot id dx dy) (
  id = 400 + i;
  hot = mx >= x && mx < x + w && my >= y && my < y + h && (!drag_id || drag_id == id);
  hot ? ( hint_id = i; );
  ldown && hot && edit_id != i ? (
    drag_id = id; drag_mx0 = mx; drag_my0 = my; drag_v0 = slider(i);
    drag_sh = shift; bound_moved = 0;
  );
  drag_id == id && lmb ? (
    dx = mx - drag_mx0; dy = drag_my0 - my;
    abs(dx) + abs(dy) > 2 * S ? bound_moved = 1;
    shift != drag_sh ? (
      drag_sh = shift; drag_mx0 = mx; drag_my0 = my; drag_v0 = slider(i);
      dx = dy = 0;
    );
    bound_moved ? set_param(i, drag_v0 + (dx + dy) * (shift ? 0.005 : 0.05) / S);
  );
  drag_id == id && !lmb && lmb_prev ? (
    !bound_moved ? edit_begin(i);
    drag_id = 0;
  );
  edit_id == i ? (
    edit_box(x, y, w, h);
  ) : (
    setc(C_TRACK, 1); rrect(x, y, w, h, 4 * S);
    setc(hot || drag_id == id ? C_SLOT : C_BG, 1);
    rrect(x + S, y + S, w - 2 * S, h - 2 * S, 3 * S);
    strcpy(#bound, fmt(slider(i), 1)); strcat(#bound, " dB");
    font(2); setc(C_TEXT, 1); txt(#bound, x, y, w, h, 1 | 4);
  );
);

function ui_bounds() local(w h y) (
  w = 76 * S; h = 16 * S; y = pl_b + 5 * S;
  ui_bound(16, g_x0, y, w, h);
  ui_bound(17, g_x0 + g_w - w, y, w, h);
);

function ui_plot() local(inp) (
  inp = mx >= pl_x && mx < pl_x + pl_w && my >= pl_y && my < pl_b;
  hov_h = (drag_id >= 100 && drag_id < 200) ? drag_id : (
    (inp && !drag_id && (!lmb || ldown)) ? find_handle() : 0);
  hov_h ? ( hint_id = hov_h; );
  ldown && hov_h ? (
    drag_id = hov_h;
    drag_mx0 = mx; drag_my0 = my; drag_sh = shift;
    (ctrl || is_dbl(hov_h)) ? reset_param(hov_h - 100);
    drag_v0 = slider(hov_h - 100);
  );
  rdown && hov_h && edit_id != hov_h - 100 ? edit_begin(hov_h - 100);
  drag_id >= 100 && drag_id < 200 && lmb ? drag_handle();
  hov_h && !lmb && wh != 0 ? ( wheel_param(hov_h - 100, wh); wh = 0; );
  ldown && inp && !hov_h && !drag_id && !edit_id && is_dbl(500) ? (
    set_param(17, pget(17, 2)); set_param(16, pget(16, 2));
  );

  draw_grid();
  ui_sync ? (
    setc(C_REL, 0.35); curve_path(6, 2 * S);
    draw_curve(2, C_SYNC, 5.5 * S);
  ) : (
    draw_band();
    draw_curve(6, C_REL, 5.5 * S);
    draw_curve(2, C_ATT, 5.5 * S);
  );
  draw_live();
  draw_handles();
  (hov_h || (edit_id && (edit_id < 5 || (edit_id > 5 && edit_id < 9)))) ? draw_tip();
  ui_bounds();
);

// ---- メーター（Peak / RMS）とゲインリダクション ----
// x 軸はグラフと共通。レベルまでを塗る（Peak は紺、RMS は山吹）。
function meter_bar(y h lvl col) local(xl) (
  xl = rnd(xpix(clamp(lvl, v_lo, v_hi)));
  xl > g_x0 ? ( setc(col, 1); frect(g_x0, y, xl - g_x0, h); );
);

// グラフの下の細いバー（上が Peak、下が RMS）。値は右の余白に数字で出す。
function ui_meters() local(y1 y2 h x) (
  h = 7 * S;
  y1 = pl_b + 27 * S; y2 = pl_b + 39 * S;
  setc(C_TRACK, 1);
  rrect(g_x0 - 2 * S, y1 - 2 * S, g_w + 4 * S, h + 4 * S, 3.5 * S);
  rrect(g_x0 - 2 * S, y2 - 2 * S, g_w + 4 * S, h + 4 * S, 3.5 * S);
  setc(C_BG, 1);
  frect(g_x0, y1, g_w, h);
  frect(g_x0, y2, g_w, h);
  meter_bar(y1, h, ui_pk, C_TEXT);
  meter_bar(y2, h, ui_rms, C_YAM);
  font(4); setc(C_DIM, 1);
  txt("PEAK", pl_x - 40 * S, y1 - 2 * S, 36 * S, h + 4 * S, 2 | 4);
  txt("RMS", pl_x - 40 * S, y2 - 2 * S, 36 * S, h + 4 * S, 2 | 4);
  x = pl_x + pl_w + 6 * S;
  font(2); setc(C_TEXT, 1);
  txt(ui_pk > -100 ? fmt(ui_pk, 1) : "-inf", x, y1 - 2 * S, 40 * S, h + 4 * S, 4);
  txt(ui_rms > -100 ? fmt(ui_rms, 1) : "-inf", x, y2 - 2 * S, 40 * S, h + 4 * S, 4);
);

// グラフ右の縦バー。縦軸はグラフのゲイン軸と共通（紺の点と高さが揃う）。
function ui_gr() local(bx barw yt yb y) (
  bx = pl_x + pl_w + 12 * S; barw = 10 * S;
  yt = ypix(0); yb = ypix(-y_span);
  setc(C_TRACK, 1); rrect(bx - 2 * S, yt - 2 * S, barw + 4 * S, yb - yt + 4 * S, 4.5 * S);
  setc(C_BG, 1); frect(bx, yt, barw, yb - yt);
  y = ypix(clamp(gdb, -y_span, 0));
  setc(C_GR, 1); frect(bx, yt, barw, y - yt);
  font(4);
  setc(C_GR, 1); txt(fmt(gdb, 1), bx - 14 * S, pl_b + 5 * S, barw + 28 * S, 13 * S, 1);
);

// ---- つまみ ----
KR = 800; // 各つまみの範囲（KR[i*4]..）。テスト用にも使う

// 太い弧の端を丸める。中心半径 rm・角度 ang・帯の太さ w。
function arc_cap(cx cy rm ang w) (
  gfx_circle(cx + sin(ang) * rm, cy - cos(ang) * rm, w * 0.5, 1, 1);
);

// 角度 ±135° に値を割り当てた円形つまみ。bip なら 0 の位置(真上)から値まで弧を引く。
function knob_draw(cx cy rad n bip hot act) local(ang rin rm w a0 a1) (
  ang = (n - 0.5) * 4.71238898038469;
  w = 4.8 * S;
  rin = rad - w;
  rm = rad - w * 0.5;
  setc(C_TRACK, 1);
  arcw(cx, cy, rin, rad, -2.356194490192345, 2.356194490192345);
  arc_cap(cx, cy, rm, -2.356194490192345, w);
  arc_cap(cx, cy, rm, 2.356194490192345, w);
  a0 = bip ? min(0, ang) : -2.356194490192345;
  a1 = bip ? max(0, ang) : ang;
  setc(act || hot ? C_YAM3 : C_YAM, 1);
  arcw(cx, cy, rin, rad, a0, a1);
  arc_cap(cx, cy, rm, a0, w);
  arc_cap(cx, cy, rm, a1, w);
  setc(C_TEXT, 1); gfx_circle(cx, cy, rin - 2.4 * S, 1, 1);
  setc(C_BG, 1);
  sline(cx + sin(ang) * 2 * S, cy - cos(ang) * 2 * S, cx + sin(ang) * (rin - 6.4 * S), cy - cos(ang) * (rin - 6.4 * S), 2.6 * S);
);

// 1 つの枠 = 名前・つまみ・値。ドラッグ（上下＋左右）で変更、ホイール、ダブルクリックで初期値、右クリックで数値入力。
function knob_slot(i sx sy sw sh) local(hot act ed ined n cx cy rad vy tw th) (
  ed = edit_id == i;
  ined = ed && mx >= edit_rx && mx < edit_rx + edit_rw && my >= edit_ry && my < edit_ry + edit_rh;
  hot = !ined && (!drag_id || drag_id == i) && mx >= sx && mx < sx + sw && my >= sy && my < sy + sh;
  KR[i * 4] = sx; KR[i * 4 + 1] = sy; KR[i * 4 + 2] = sw; KR[i * 4 + 3] = sh;
  hot ? ( hint_id = i; );
  ldown && hot ? (
    drag_id = i;
    drag_mx0 = mx; drag_my0 = my; drag_sh = shift;
    (ctrl || is_dbl(i)) ? reset_param(i);
    drag_n0 = p_norm(i, slider(i));
  );
  rdown && hot && !ed ? edit_begin(i);
  drag_id == i && lmb ? (
    shift != drag_sh ? ( drag_sh = shift; drag_mx0 = mx; drag_my0 = my; drag_n0 = p_norm(i, slider(i)); );
    set_param(i, p_from_norm(i, drag_n0 + (shift ? 0.1 : 1) * ((drag_my0 - my) + (mx - drag_mx0) * 0.5) / (150 * S)));
  );
  hot && wh != 0 && !drag_id ? ( wheel_param(i, wh); wh = 0; );

  act = drag_id == i;
  n = p_norm(i, slider(i));
  hot || act ? ( setc(C_SLOT, 1); rrect(sx + 1 * S, sy, sw - 2 * S, sh - 4 * S, 8 * S); );
  font(7); setc(C_TEXT, 1);
  txt(pget(i, 7), sx, sy + 2 * S, sw, 12 * S, 1 | 4);
  rad = 17 * S; cx = sx + sw * 0.5; cy = sy + 18 * S + rad;
  knob_draw(cx, cy, rad, n, pget(i, 10), hot, act);
  vy = sy + 18 * S + 2 * rad + 5 * S;
  ed ? edit_box(sx + 3 * S, vy, sw - 6 * S, 17 * S) : (
    strcpy(#kv, fmt(slider(i), pget(i, 5)));
    strcat(#kv, " ");
    strcat(#kv, pget(i, 6));
    font(1); setc(act || hot ? C_TEXT : C_DIM, 1);
    txt(#kv, sx, vy, sw, 17 * S, 1 | 4);
  );
);

// 見出し付きのつまみのグループ。次の x を返す。
function knob_group(title n p0 p1 p2 x) local(k p tw th) (
  font(4); setc(C_DIM, 1);
  gfx_measurestr(title, tw, th);
  txt(title, x + 2 * S, kz_y, tw + 8 * S, 12 * S, 4);
  setc(C_RULE, 1);
  gfx_line(x + tw + 12 * S, kz_y + 6 * S, x + n * kw - 2 * S, kz_y + 6 * S, 0);
  k = 0;
  loop(n,
    p = k == 0 ? p0 : (k == 1 ? p1 : p2);
    knob_slot(p, x + k * kw, kz_y + 14 * S, kw, kz_h - 14 * S);
    k += 1;
  );
  x + n * kw + gg;
);

function ui_knobs() local(x) (
  x = mg;
  x = knob_group("DETECTION", 3, 9, 11, 12, x);
  x = knob_group("REDUCTION", 1, 1, 0, 0, x);
  x = knob_group("ATTACK", 2, 14, 19, 0, x);
  x = knob_group("RELEASE", 2, 15, 20, 0, x);
);

// ---- ヘッダー（タイトル・凡例・SYNC） ----
// 凡例は紺のタグ。グラフと同じ紺の地に、山吹と白の印を置く。
function leg_item(x y col al label w) (
  setc(col, al); gfx_circle(x + 5 * S, y + 8 * S, 4.5 * S, 1, 1);
  font(5); setc(C_BG, al > 0.5 ? 1 : 0.6);
  txt(label, x + 15 * S, y, w + 4 * S, 16 * S, 4);
);

SY = 900; // SYNC ボタンの範囲（SY[0..3]）。テスト用にも使う
function sync_pill(x y w h) local(hot) (
  hot = !drag_id && mx >= x && mx < x + w && my >= y && my < y + h;
  SY[0] = x; SY[1] = y; SY[2] = w; SY[3] = h;
  hot ? ( hint_id = 300; );
  ldown && hot ? set_sync(!ui_sync);
  ui_sync ? (
    setc(hot ? C_YAM2 : C_YAM, 1); rrect(x, y, w, h, h * 0.5);
  ) : (
    setc(C_TEXT, 1); rrect(x, y, w, h, h * 0.5);
    setc(hot ? C_SLOT : C_BG, 1); rrect(x + 2 * S, y + 2 * S, w - 4 * S, h - 4 * S, h * 0.5 - 2 * S);
  );
  setc(ui_sync ? C_TEXT : C_FAINT, 1); gfx_circle(x + h * 0.5 + 1 * S, y + h * 0.5, 3.8 * S, 1, 1);
  font(6); setc(C_TEXT, 1);
  txt("SYNC", x + h, y, w - h - 8 * S, h, 1 | 4);
);

function ui_header() local(x tw th w1 w2 hh lw) (
  font(3); setc(C_TEXT, 1);
  gfx_measurestr("AZMbeziExp", tw, th);
  txt("AZMbeziExp", mg + 2 * S, 8 * S, tw + 4 * S, 28 * S, 4);
  strcpy(#lg1, ui_sync ? "Attack = Release" : "Attack");
  strcpy(#lg2, ui_sync ? "Release (kept)" : "Release");
  font(5);
  gfx_measurestr(#lg1, w1, hh);
  gfx_measurestr(#lg2, w2, hh);
  x = mg + tw + 30 * S;
  lw = 14 * S + 15 * S + w1 + 16 * S + 15 * S + w2 + 14 * S;
  setc(C_PLOT, 1); rrect(x, 11 * S, lw, 26 * S, 13 * S);
  ui_sync ? (
    leg_item(x + 14 * S, 16 * S, C_SYNC, 1, #lg1, w1);
    leg_item(x + 14 * S + 15 * S + w1 + 16 * S, 16 * S, C_REL, 0.45, #lg2, w2);
  ) : (
    leg_item(x + 14 * S, 16 * S, C_ATT, 1, #lg1, w1);
    leg_item(x + 14 * S + 15 * S + w1 + 16 * S, 16 * S, C_REL, 1, #lg2, w2);
  );
  sync_pill(gfx_w - mg - 92 * S, 11 * S, 92 * S, 26 * S);
);

// ---- フッター（ホバー中の項目のヒント） ----
function ui_footer() local(p x w th tw) (
  setc(C_PANEL, 1); rrect(mg, ft_y, gfx_w - 2 * mg, ft_h, 7 * S);
  x = mg + 12 * S;
  font(2);
  edit_id ? (
    setc(C_TEXT, 1);
    txt("Type a value.   Enter: apply     Esc: cancel     Click elsewhere: apply", x, ft_y, gfx_w, ft_h, 4);
  ) : (
    hint_id == 300 ? (
      setc(C_TEXT, 1); txt("Sync", x, ft_y, 60 * S, ft_h, 4);
      setc(C_DIM, 1);
      txt("Release uses Attack's curve. Stored Release still clamps to graph bounds.", x + 38 * S, ft_y, gfx_w, ft_h, 4);
    ) : (
      hint_id ? (
        p = hint_id >= 100 ? hint_id - 100 : hint_id;
        strcpy(#ft, pget(p, 8));
        strcat(#ft, "  ");
        strcat(#ft, fmt(slider(p), pget(p, 5)));
        strcat(#ft, " ");
        strcat(#ft, pget(p, 6));
        gfx_measurestr(#ft, tw, th);
        setc(C_TEXT, 1); txt(#ft, x, ft_y, tw + 4 * S, ft_h, 4);
        setc(C_DIM, 1); txt(pget(p, 9), x + tw + 18 * S, ft_y, gfx_w, ft_h, 4);
      ) : (
        setc(C_DIM, 1);
        txt("Drag the handles to shape the curves.   Right-click: type a value   Double-click: reset   Shift: fine", x, ft_y, gfx_w, ft_h, 4);
      );
    );
  );
);

function ui_frame() (
  ui_begin();
  setc(C_BG, 1); gfx_rect(0, 0, gfx_w, gfx_h);
  ui_header();
  ui_plot();
  ui_meters();
  ui_gr();
  ui_knobs();
  ui_footer();
  ui_end();
);

@slider
on_slider();

@block
// GUI で変更されたパラメーターを、オーディオスレッド側で @slider と同じ処理に通す
ui_dirty ? ( ui_dirty = 0; on_slider(); );

@sample
// ステレオリンク（L/R の大きい方）で検出
a = max(abs(spl0), abs(spl1));

// Peak is instantaneous; RMS has only its averaging window.
msq = max(msq + rms_k * (a * a - msq), floor_pow);
rms_raw = sqrt(2 * msq);
pk_lin = a * pk_gain;
rms_lin = rms_raw * rms_gain;
a_lin = max(pk_lin * (1 - a_mix) + rms_lin * a_mix, floor_amp);
r_lin = max(pk_lin * (1 - r_mix) + rms_lin * r_mix, floor_amp);
dir_a_f += (a_lin - dir_a_f) * dir_k;
dir_r_f += (r_lin - dir_r_f) * dir_k;

// Attack wins if both conditions are true; neither leaves direction unchanged.
!gain_init ? (
  dir_a_f > prev_dir_a ? ( dir_up = 1; ) : dir_r_f < prev_dir_r ? ( dir_up = 0; );
);
prev_dir_a = dir_a_f;
prev_dir_r = dir_r_f;
lin = dir_up ? a_lin : r_lin;
lvl_db = log(lin) * 8.685889638065037;
m_pk = max(m_pk, pk_lin);
m_rms = max(m_rms, rms_lin);
m_lin = max(m_lin, lin);

tgt = dir_up ? curve_db(lvl_db, a_close, a_span, a_c, range_db)
             : curve_db(lvl_db, e_close, r_span, r_c, range_db);
gain_init ? ( gdb = tgt; gain_init = 0; ) : (
  gdb < tgt ? ( gdb = min(tgt, gdb + (tgt - gdb + eps_db) * k_open); )
             : gdb > tgt ? ( gdb = max(tgt, gdb + (tgt - gdb - eps_db) * k_close); );
);

gain = exp(gdb * 0.11512925464970229);
spl0 *= gain;
spl1 *= gain;

@gfx 800 520
ui_frame();
