desc:AZMbeziExp
tags:gate expander dynamics vocal

// - 単純なテキストだけなのでバグとかはあんまりないとおもいますが、利用は自己責任でお願いします
// - 再配布やめてね
// - 改変は歓迎です（真新しいアイデアでもないので）、ただし改善できたら是非教えてください

options:no_meter

slider1:range_db=60<0,96,0.1>-Reduction (dB)
slider2:a_rng=10<0.1,60,0.1>-Attack Curve Range below Open (dB)
slider3:a_open=-55<-90,0,0.1>-Attack Curve Open (dB)
slider4:a_curve=60<-100,100,1>-Attack Curve (%)
slider5:curve_sync=0<0,1,1{Off,On}>-Sync Attack/Release Curves
slider6:r_close=-55<-90,0,0.1>-Release Curve Close (dB)
slider7:r_rng=15<0.1,60,0.1>-Release Curve Range above Close (dB)
slider8:r_curve=-60<-100,100,1>-Release Curve (%)
slider9:rms_sens=6<-24,24,0.1>-RMS Sensitivity (dB)
slider10:rms_time=60<1,200,1:log>-RMS Window (ms)
slider11:g_open=10<0.1,100,0.1:log>-Attack Smoothing Time (ms)
slider12:g_close=120<0.1,500,0.1:log>-Release Smoothing Time (ms)
slider13:attack_mix=30<0,100,1>-Attack RMS Ratio (%)
slider14:release_mix=60<0,100,1>-Release RMS Ratio (%)
slider15:bypass=0<0,1,1{Off,On}>-Bypass
slider16:rms_open=1<0,1,1{Closed,Open}>-RMS Control Open

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
gfx_ext_retina = 1; // HiDPI では gfx_w/gfx_h が実ピクセルになる
SS = 2; // 画面外バッファに SS 倍の解像度で描き、縮小して表示する（スーパーサンプリングによるアンチエイリアス）
buf_w = buf_h = 0;

function decay_of(ms) (
  exp(-1 / max(ms * 0.001 * srate, 1));
);

// Close..Open を正規化し、制御点 (0,0) (x1,y1) (1,1) の2次ベジェ曲線でゲインに写像する。
// x(u)=2(1-u)u*x1+u²=t を u について解く（x1 が [0,1] 内なら x(u) は単調）。
function curve_db(lvl, close, span, x1, y1, range)
  local(t u)
(
  t = (lvl - close) / span;
  t <= 0 ? ( -range ) : (
    t >= 1 ? ( 0 ) : (
      u = t / (x1 + sqrt(x1 * x1 + (1 - 2 * x1) * t));
      -range * (1 - u * (2 * (1 - u) * y1 + u));
    );
  );
);

// カーブの位置は「基準 + 相対ゲイン」で持つ。Attack は Open の下へ a_rng、Release は Close の上へ r_rng。
// Sync 中も Release のスライダー値を保持し、e_* に実際に使うカーブを設定する。
function update_coefs() (
  a_close = a_open - a_rng;
  r_open = r_close + r_rng;
  e_close = sync_on ? a_close : r_close;
  e_open = sync_on ? a_open : r_open;
  a_span = max(a_rng, 0.01);
  r_span = max(e_open - e_close, 0.01);
  // 曲線の強さ c (-1..1) は制御点を対角線に直交する線上で動かす。+ は後から開く（下に凸）、- は早く開く。
  a_c = min(max(a_curve * 0.01, -1), 1);
  r_c = min(max((sync_on ? a_curve : r_curve) * 0.01, -1), 1);
  a_x1 = 0.5 + 0.5 * a_c; a_y1 = 0.5 - 0.5 * a_c;
  r_x1 = 0.5 + 0.5 * r_c; r_y1 = 0.5 - 0.5 * r_c;

  rms_gain = exp(rms_sens * 0.11512925464970229);
  rms_k = 1 - decay_of(rms_time);
  k_open = 1 - decay_of(g_open);
  k_close = 1 - decay_of(g_close);
  dir_k = 1 - decay_of(2);
  a_mix = min(max(attack_mix * 0.01, 0), 1);
  r_mix = min(max(release_mix * 0.01, 0), 1);
);

// スライダー変更時の処理。@slider のほか、GUI 操作後の @block からも呼ぶ。
// GUI 側の sliderchange() で @slider が再実行されるかに依存しないよう、
// オーディオスレッドだけが係数更新を行う（@gfx はこの関数を呼ばない）。
function on_slider() (
  sync_on = curve_sync >= 0.5;
  update_coefs();
);

// デノーマル回避用の下限（EEL2 では 1e-12 の指数表記が使えない）
floor_amp = pow(10, -12);
floor_pow = pow(10, -24);
eps_db = pow(10, -9);

msq = 0;
gain_init = 1;
gdb = 0;
byp_m = bypass >= 0.5;
byp_k = 1 - exp(-1 / max(srate * 0.005, 1));

// Direction uses a short slope detector so per-sample polarity flips do not
// immediately switch curves.
dir_up = 0;
dir_a_f = dir_r_f = 0;
prev_dir_a = prev_dir_r = 0;

// GUI との受け渡し用。m_a / m_r は @sample が前回描画以降の最大値（Peak・RMS を各 RMS Ratio で混ぜた
// 線形振幅）を貯め、@gfx が読んで 0 に戻す。m_up は直近の方向（1 = Attack 側のカーブが目標）。
// ui_dirty は @gfx が立て、@block が下ろす。
m_a = 0;
m_r = 0;
m_up = 0;
ui_dirty = 0;

// @gfx は @sample と別スレッドで動く。@sample が使う変数名
// (a, msq, pk_lin, rms_lin, lin, lvl_db, la, lr, tgt, dir_up, gain, gdb など) を
// 書き換えないこと。関数内の一時変数は必ず local() にする。
// DSP と共有してよいのは slider 変数・m_*・ui_dirty と、GR 表示のために読むだけの gdb。
// curve_db は @sample が使う関数なので @gfx からは呼ばない（GUI 側は下の gain_at で評価する）。
// EEL2 の識別子は大文字小文字を区別しない（S と s は同じ）ので、S を使う関数に s という名前の引数は付けない。

ui_a = ui_r = -120; // 合成後の検知レベル（dB）。Attack 側・Release 側
TH = 1100; TN = 6; // 検知レベルの履歴（残像用）。TH[i*2] = Attack, TH[i*2+1] = Release（i=0 が最新）
memset(TH, -120, TN * 2);
ui_hl = 0; // Attack 側がアクティブなら 1 に寄る（ハイライトのなめらかな切り替え用）
ui_axis_init = 0;
t_prev = time_precise();

BW = 940; BH = 520;

C_BG = 0xFFFFFF; C_PANEL = 0xF3F5F9; C_TRACK = 0xDFE4EE; C_SLOT = 0xEEF1F7; C_RULE = 0xD5DBE8;
C_TEXT = 0x1F2E54; C_DIM = 0x5F6B8A; C_FAINT = 0x9AA4BC;
C_PLOT = 0x1F2E54; C_GRID = 0x30426F; C_GRID2 = 0x4A5E94;
C_YAM = 0xF0B13A; C_YAM2 = 0xF7C968; C_YAM3 = 0xDF9A22;
C_ATT = 0xF0B13A; C_REL = 0xFFFFFF; C_SYNC = 0xF0B13A; C_GR = 0x1F2E54;

function clamp(x lim_lo lim_hi) ( x < lim_lo ? lim_lo : (x > lim_hi ? lim_hi : x) );
function rnd(x) ( floor(x + 0.5) );

function setc(col alpha) (
  gfx_set(((col >> 16) & 255) / 255, ((col >> 8) & 255) / 255, (col & 255) / 255, alpha);
);

// 端を丸めた座標で塗る（隣接矩形の隙間・重なりを防ぐ）
function frect(x y w h) local(x0 y0 x1 y1) (
  x0 = rnd(x); y0 = rnd(y); x1 = rnd(x + w); y1 = rnd(y + h);
  x1 > x0 && y1 > y0 ? gfx_rect(x0, y0, x1 - x0, y1 - y0);
);

// 角丸の塗り（gfx_roundrect は枠線のみのため自前）。不透明色専用。
// gfx_circle は中心±r を含む(2r+1 px)ので、半ピクセルずらして矩形の端に合わせる。
function rrect(x y w h r) (
  x = rnd(x); y = rnd(y); w = rnd(w); h = rnd(h);
  r = min(r, min(w, h) * 0.5);
  frect(x + r, y, w - 2 * r, h);
  frect(x, y + r, r, h - 2 * r);
  frect(x + w - r, y + r, r, h - 2 * r);
  gfx_circle(x + r - 0.5, y + r - 0.5, max(r - 0.5, 0.5), 1, 1);
  gfx_circle(x + w - r - 0.5, y + r - 0.5, max(r - 0.5, 0.5), 1, 1);
  gfx_circle(x + r - 0.5, y + h - r - 0.5, max(r - 0.5, 0.5), 1, 1);
  gfx_circle(x + w - r - 0.5, y + h - r - 0.5, max(r - 0.5, 0.5), 1, 1);
);

function tline(x1 y1 x2 y2 th) local(dx dy l n j o) (
  th <= 1.2 ? gfx_line(x1, y1, x2, y2, 1) : (
    dx = x2 - x1; dy = y2 - y1;
    l = max(sqrt(dx * dx + dy * dy), 0.0001);
    n = ceil(th - 0.01);
    j = 0;
    loop(n,
      o = j - (n - 1) * 0.5;
      gfx_line(x1 - dy / l * o, y1 + dx / l * o, x2 - dy / l * o, y2 + dx / l * o, 1);
      j += 1;
    );
  );
);

// 不透明色専用。円を重ねて太さの一定な線を描く。
function sline(x0 y0 x1 y1 th) local(r l n k t) (
  r = th * 0.5;
  l = sqrt((x1 - x0) * (x1 - x0) + (y1 - y0) * (y1 - y0));
  n = max(ceil(l / max(r * 0.45, 0.8)), 1);
  k = 0;
  loop(n + 1,
    t = k / n;
    gfx_circle(x0 + (x1 - x0) * t, y0 + (y1 - y0) * t, r, 1, 1);
    k += 1;
  );
);

// 中心(cx,cy)・半径 r1〜r2・角度 a0〜a1(rad, 真上が 0・時計回りが正) の円弧の帯
function arcw(cx cy r1 r2 a0 a1) local(r) (
  a1 - a0 > 0.01 ? (
    r = r1;
    while (r <= r2 + 0.01) ( gfx_arc(cx, cy, r, a0, a1, 1); r += 0.5; );
  );
);

function font(id) local(sz fl) (
  sz = 12; fl = 0;
  id == 2 ? ( sz = 11; );
  id == 3 ? ( sz = 17; fl = 'b'; );
  id == 4 ? ( sz = 10; );
  id == 5 ? ( sz = 11; fl = 'b'; );
  id == 6 ? ( sz = 12; fl = 'b'; );
  id == 7 ? ( sz = lbl_fs / S; fl = 'b'; );
  gfx_setfont(id, "Arial", max(rnd(sz * S), 6), fl);
);

// flags: 1=横中央 2=右寄せ 4=縦中央
function txt(msg x y w h fl) (
  gfx_x = x; gfx_y = y;
  gfx_drawstr(msg, fl, x + w, y + h);
);

// 小数 dec 桁の文字列（"-0.0" を避けるため先に丸める）
function fmt(v dec) local(p r) (
  p = 10 ^ dec;
  r = floor(abs(v) * p + 0.5) / p;
  v < 0 && r > 0 ? ( r = -r; );
  dec < 1 ? sprintf(#fmt, "%.0f", r) : (
    dec < 2 ? sprintf(#fmt, "%.1f", r) : sprintf(#fmt, "%.2f", r));
  #fmt;
);

// ---- パラメーター表（スライダー行の宣言と同じ値。5 番の Sync は別扱い） ----
// 0..4: 最小 最大 既定 刻み log / 5: 小数桁 / 6: 単位 / 7: 短い名前 / 8: 正式名 / 9: ヒント / 10: 0 中心のノブ
// GUI tables and hit-test rectangles occupy separate memory regions.
PT = 512;
function pdef(i mn mx df st lg dc unit nm fnm hnt bip) local(b) (
  b = PT + i * 12;
  b[0] = mn; b[1] = mx; b[2] = df; b[3] = st; b[4] = lg; b[5] = dc;
  b[6] = unit; b[7] = nm; b[8] = fnm; b[9] = hnt; b[10] = bip;
);
function pget(i f) local(b) ( b = PT + i * 12; b[f]; );

// 曲線 b=2 (Attack) / 6 (Release) の Close / Open の位置。Attack は Open が基準、Release は Close が基準。
function cl_of(b) ( b == 2 ? slider(3) - slider(2) : slider(6); );
function op_of(b) ( b == 2 ? slider(3) : slider(6) + slider(7); );

// 値と単位の表示。Range は相対ゲインなので Attack は下向き（−）、Release は上向き（+）の符号を付ける。
function pstr(i) (
  strcpy(#pstr, i == 7 ? "+" : "");
  strcat(#pstr, fmt(i == 2 || i == 1 ? -slider(i) : slider(i), i == 1 && abs(slider(1) - floor(slider(1) + 0.5)) < 0.05 ? 0 : pget(i, 5)));
  strcat(#pstr, " ");
  strcat(#pstr, pget(i, 6));
  #pstr;
);

pdef(1, 0, 96, 60, 0.1, 0, 1, "dB", "Reduction", "Reduction", "Maximum attenuation when closed. Also sets the graph's gain axis", 0);
pdef(2, 0.1, 60, 10, 0.1, 0, 1, "dB", "Range", "Attack Range", "Used while the level rises. Fully closed this many dB below Open", 0);
pdef(3, -90, 0, -55, 0.1, 0, 1, "dB", "Open", "Attack Open", "Used while the level rises. Fully open (0 dB) at or above this level. Moves the whole curve", 0);
pdef(4, -100, 100, 60, 1, 0, 0, "%", "Curve", "Attack Curve", "Used while the level rises. + opens late, - opens early, 0 is straight", 1);
pdef(6, -90, 0, -55, 0.1, 0, 1, "dB", "Close", "Release Close", "Used while the level falls. Fully closed at or below this level. Moves the whole curve", 0);
pdef(7, 0.1, 60, 15, 0.1, 0, 1, "dB", "Range", "Release Range", "Used while the level falls. Fully open this many dB above Close", 0);
pdef(8, -100, 100, -60, 1, 0, 0, "%", "Curve", "Release Curve", "Used while the level falls. + opens late, - opens early, 0 is straight", 1);
pdef(9, -24, 24, 6, 0.1, 0, 1, "dB", "Sens", "RMS Sensitivity", "Gain on the RMS detector. + opens on quieter sounds", 1);
pdef(10, 1, 200, 60, 1, 1, 0, "ms", "Window", "RMS Window", "Averaging time of the RMS detector", 0);
pdef(11, 0.1, 100, 10, 0.1, 1, 1, "ms", "Smoothing Time", "Attack Smoothing Time", "Gain smoothing time while the gain opens", 0);
pdef(12, 0.1, 500, 120, 0.1, 1, 1, "ms", "Smoothing Time", "Release Smoothing Time", "Gain smoothing time while the gain closes", 0);
pdef(13, 0, 100, 30, 1, 0, 0, "%", "RMS Ratio", "Attack RMS Ratio", "0% follows Peak; 100% follows RMS", 0);
pdef(14, 0, 100, 60, 1, 0, 0, "%", "RMS Ratio", "Release RMS Ratio", "0% follows Peak; 100% follows RMS", 0);

function pq(i v) local(pmn pmx pst) (
  pmn = pget(i, 0); pmx = pget(i, 1); pst = pget(i, 3);
  clamp(floor((v - pmn) / pst + 0.5) * pst + pmn, pmn, pmx);
);
function p_norm(i v) local(pmn pmx) (
  pmn = pget(i, 0); pmx = pget(i, 1);
  pget(i, 4) ? log(max(v, pmn) / pmn) / log(pmx / pmn) : (v - pmn) / (pmx - pmn);
);
function p_from_norm(i n) local(pmn pmx) (
  pmn = pget(i, 0); pmx = pget(i, 1); n = clamp(n, 0, 1);
  pget(i, 4) ? pmn * exp(n * log(pmx / pmn)) : pmn + n * (pmx - pmn);
);

// GUI 側でスライダー値を書き換えたことを通知する。係数の再計算は @gfx では行わず、
// フラグだけ立てて @block（オーディオスレッド）で行う（関数のローカル変数がスレッド間で共有されるため）。
function notify(i) (
  sliderchange(slider(i));
  slider_automate(slider(i));
  ui_dirty = 1;
);

// パラメーター変更の窓口。Range（2, 7）は大きさだけを持つので符号は無視する。
// Release の Open（= Close + Range）は 0 dB を超えないようにする。
function set_param(i v) local(old) (
  (i == 1 || i == 2 || i == 7) ? ( v = abs(v); );
  i == 6 ? ( v = min(v, -slider(7)); );
  i == 7 ? ( v = min(v, -slider(6)); );
  v = pq(i, v);
  old = slider(i);
  v != old ? ( slider(i) = v; notify(i); );
);
function reset_param(i) ( set_param(i, pget(i, 2)); );

function set_sync(on) (
  slider(5) = on ? 1 : 0; notify(5);
  ui_sync = on;
);

// ホイール 1 ノッチ = つまみの移動量の 2%（Shift で 0.2%）。最低 1 ステップは動かす。
function wheel_param(i w) local(old v st) (
  old = slider(i); st = pget(i, 3);
  v = pq(i, p_from_norm(i, p_norm(i, old) + w * (shift ? 0.002 : 0.02)));
  abs(v - old) < st * 0.5 ? ( v = old + (w > 0 ? st : -st); );
  set_param(i, v);
);

function is_dbl(id) local(d) (
  d = id == lc_id && now - lc_t < 0.4;
  lc_id = d ? 0 : id;
  lc_t = now;
  d;
);

function edit_commit() local(ok v) (
  edit_id ? (
    ok = edit_digits > 0 && match("%f", #edit_str, v);
    ok ? set_param(edit_id, v);
    edit_id = 0;
  );
);
function edit_begin(i) local(c) (
  edit_id ? edit_commit();
  c = 1;
  while (c > 0) ( c = gfx_getchar(); ); // 入力開始前に溜まっていたキーは捨てる
  edit_id = i;
  edit_fld = 0; // 欄から開始したときだけ ui_field が 1 にする
  edit_t0 = now;
  strcpy(#edit_str, fmt(slider(i), pget(i, 5)));
  edit_digits = 1;
  edit_fresh = 1; // 最初の入力で全置換
);
function edit_key(c) local(n ch) (
  edit_t0 = now;
  c == 13 || c == 10 ? ( edit_commit(); ) : (
  c == 27 ? ( edit_id = 0; ) : (
  c == 8 ? (
    edit_fresh ? ( strcpy(#edit_str, ""); edit_digits = 0; edit_fresh = 0; ) : (
      n = strlen(#edit_str);
      n > 0 ? (
        ch = str_getchar(#edit_str, n - 1);
        ch >= 48 && ch <= 57 ? ( edit_digits -= 1; );
        str_delsub(#edit_str, n - 1, 1);
      );
    );
  ) : (
    ch = c == 44 ? 46 : c; // ',' は '.' として扱う
    ((ch >= 48 && ch <= 57) || ch == 46 || ch == 45) && strlen(#edit_str) < 9 ? (
      edit_fresh ? ( strcpy(#edit_str, ""); edit_digits = 0; edit_fresh = 0; );
      ch >= 48 && ch <= 57 ? ( edit_digits += 1; );
      str_setchar(#edit_str, strlen(#edit_str), ch);
    );
  )));
);

// 入力中だけキー入力を受け取る（それ以外では gfx_getchar を呼ばず、キーは REAPER 側に任せる）
function ui_keys() local(c) (
  c = 1;
  while (edit_id && c != 0) (
    c = gfx_getchar();
    c < 0 ? ( edit_id = 0; ) : ( c > 0 ? edit_key(c); );
  );
);

function edit_box(x y w h) local(str tw th tx) (
  edit_rx = x; edit_ry = y; edit_rw = w; edit_rh = h;
  setc(C_YAM, 1); rrect(x, y, w, h, 5 * S);
  setc(C_BG, 1); rrect(x + 2 * S, y + 2 * S, w - 4 * S, h - 4 * S, 3.5 * S);
  font(1);
  str = #edit_str;
  gfx_measurestr(str, tw, th);
  tx = x + w - 8 * S - tw;
  edit_fresh ? ( setc(C_YAM, 0.4); frect(tx - 2 * S, y + 3.5 * S, tw + 4 * S, h - 7 * S); );
  setc(C_TEXT, 1);
  txt(str, tx, y, tw + 4 * S, h, 4);
  !edit_fresh && floor((now - edit_t0) * 2) % 2 == 0 ? ( setc(C_TEXT, 1); frect(x + w - 7 * S, y + 4 * S, max(S, 1), h - 8 * S); );
);

function fit_labels() local(i tw th wmax fs) (
  font(5);
  wmax = 1;
  i = 9;
  loop(6,
    gfx_measurestr(pget(i, 7), tw, th); wmax = max(wmax, tw);
    i += 1;
  );
  fs = max(rnd(11 * S), 6);
  lbl_fs = clamp(floor(fs * (kw - 4 * S) / wmax), 6, fs);
);

// 検知レベルの dB 表示値。速い立ち上がり・遅い減衰（45 dB/秒）で見せる。
function det_db(v prev) ( max(v > 0.000001 ? log(v) * 8.685889638065037 : -120, prev - 45 * dt); );

// グラフの横軸は、使っている曲線の Close / Open の外側 10 dB まで。ドラッグ中は動かさず、離したらなめらかに追従する。
function update_axis() local(c1 c2 o1 o2 t_lo t_hi k) (
  c1 = cl_of(2); o1 = op_of(2);
  c2 = ui_sync ? c1 : cl_of(6);
  o2 = ui_sync ? o1 : op_of(6);
  t_lo = min(c1, c2) - 10;
  t_hi = max(o1, o2) + 10;
  !ui_axis_init ? (
    v_lo = t_lo; v_hi = t_hi; ui_axis_init = 1;
  ) : (
    !((drag_id >= 100 && drag_id < 200) || (drag_id >= 400 && drag_id < 500)) ? (
      k = 1 - exp(-dt * 14);
      v_lo += (t_lo - v_lo) * k;
      v_hi += (t_hi - v_hi) * k;
      abs(t_lo - v_lo) < 0.01 ? v_lo = t_lo;
      abs(t_hi - v_hi) < 0.01 ? v_hi = t_hi;
    );
  );
);

function ui_begin() (
  S = max(min(ui_w / BW, ui_h / BH), 0.25);
  now = time_precise();
  dt = clamp(now - t_prev, 0.001, 0.25);
  t_prev = now;

  mx = mouse_x * SS; my = mouse_y * SS;
  lmb = mouse_cap & 1;
  rmb = mouse_cap & 2;
  ldown = lmb && !lmb_prev;
  rdown = rmb && !rmb_prev;
  shift = mouse_cap & 8;
  ctrl = mouse_cap & 4;
  wh = mouse_wheel / 120;
  mouse_wheel = 0;
  !lmb && !(drag_id >= 400 && lmb_prev) ? ( drag_id = 0; );
  ui_sync = curve_sync >= 0.5;
  hint_id = 0;
  // 入力中の欄の外をクリックしたら、そのクリックを処理する前に確定する
  (ldown || rdown) && edit_id && !(mx >= edit_rx && mx < edit_rx + edit_rw && my >= edit_ry && my < edit_ry + edit_rh) ? edit_commit();
  ui_keys();

  // audio スレッドが貯めた最大値を取り込む。ui_hl は Attack 側がアクティブなときに 1 へ寄る。
  ui_a = det_db(m_a, ui_a); m_a = 0;
  ui_r = det_db(m_r, ui_r); m_r = 0;
  memcpy(TH + 2, TH, (TN - 1) * 2);
  TH[0] = ui_a; TH[1] = ui_r;
  ui_hl += (m_up - ui_hl) * (1 - exp(-dt * 20));

  update_axis();
  v_span = v_hi - v_lo;
  y_span = max(range_db, 1);

  mg = 44 * S; // 全パーツ共通の左右余白（ヘッダー、グラフ、リダクションメーター、欄、RMS CONTROL、フッターの端をそろえる）
  ft_h = 22 * S; ft_y = ui_h - 18 * S - ft_h;
  rms_on = rms_open >= 0.5;
  sec_h = (rms_on ? 98 : 22) * S;
  kz_y = ft_y - 6 * S - sec_h; // RMS Control セクションの上端
  kg_y = kz_y + 20 * S; // グループ名の行
  gg = 16 * S;
  kw = (ui_w - 2 * mg - 2 * gg) / 6;
  fit_labels();

  pl_x = mg;
  pl_y = 53 * S;
  mt_w = 30 * S; mt_gap = 8 * S; // 右端のリダクションメーター
  pl_w = max(ui_w - 2 * mg - mt_w - mt_gap, 60 * S);
  pl_b = max(kz_y - 46 * S, pl_y + 80 * S);
  pl_h = pl_b - pl_y;
  // 軸の数字はグラフの内側（左端と下端）に置く。曲線を描く領域はその内側。
  g_x0 = pl_x + 30 * S; g_w = pl_w - 30 * S - 14 * S;
  g_y0 = pl_y + 12 * S; g_h = pl_h - 12 * S - 22 * S;
  g_b = g_y0 + g_h;
  clip_l = g_x0 - 4 * S; clip_r = pl_x + pl_w - S;
  hit_r2 = (16 * S) * (16 * S);
);

function ui_end() (
  lmb_prev = lmb;
  rmb_prev = rmb;
);

function xpix(db) ( g_x0 + (db - v_lo) * g_w / v_span; );
function ypix(g) ( g_y0 - g * g_h / y_span; );
// 端点 0, 1 の2次ベジェの1軸分。qu は qx(u) = t を満たす u（p1 が [0,1] 内なら単調）。
function qx(u p1) ( u * (2 * (1 - u) * p1 + u); );
function qu(t p1) ( t <= 0 ? 0 : t / (p1 + sqrt(p1 * p1 + (1 - 2 * p1) * t)); );
// 各曲線のスライダー番号。b=2 (Attack) / 6 (Release)。
function cidx(b) ( b == 2 ? 4 : 8; );
// 曲線の強さ (-1..1) から制御点 (cp_x, cp_y) を求める。
function cp_load(b) local(c) (
  c = clamp(slider(cidx(b)) * 0.01, -1, 1);
  cp_x = 0.5 + 0.5 * c; cp_y = 0.5 - 0.5 * c;
);

// 横方向を clip_l〜clip_r に切り詰めて線を引く（gfx にクリップ機能がないため）。
// 太い線は塗りつぶした円を密に並べて引く（斜めでも太さが一定で、縁がなめらか）。水平な線は角のそろった長方形。
// 細い線（Sync 中に残す Release など、半透明で引く線）は重ねると濃くなるので tline を使う。
function cseg(x0 y0 x1 y1 th) local(t r l n k xx yy) (
  (x0 < clip_l && x1 < clip_l) || (x0 > clip_r && x1 > clip_r) ? 0 : (
    x0 < clip_l ? ( t = (clip_l - x0) / (x1 - x0); y0 += (y1 - y0) * t; x0 = clip_l; );
    x1 < clip_l ? ( t = (clip_l - x1) / (x0 - x1); y1 += (y0 - y1) * t; x1 = clip_l; );
    x0 > clip_r ? ( t = (x0 - clip_r) / (x0 - x1); y0 += (y1 - y0) * t; x0 = clip_r; );
    x1 > clip_r ? ( t = (x1 - clip_r) / (x1 - x0); y1 += (y0 - y1) * t; x1 = clip_r; );
    th > 3 * S ? (
      r = th * 0.5;
      abs(y1 - y0) < 0.01 ? (
        frect(min(x0, x1), rnd(y0 - r), abs(x1 - x0), max(rnd(y0 + r) - rnd(y0 - r), 1));
      ) : (
        l = sqrt((x1 - x0) * (x1 - x0) + (y1 - y0) * (y1 - y0));
        n = max(ceil(l / max(r * 0.45, 0.8)), 1);
        k = 0;
        loop(n + 1,
          t = k / n;
          xx = x0 + (x1 - x0) * t; yy = y0 + (y1 - y0) * t;
          xx >= clip_l + r && xx <= clip_r - r ? gfx_circle(xx, yy, r, 1, 1); // 枠にかかる円は描かない
          k += 1;
        );
      );
    ) : (
      tline(x0, y0, x1, y1, th);
    );
  );
);

function draw_grid() local(k x y raw step g dec every db first n) (
  setc(C_PLOT, 1);
  rrect(pl_x, pl_y, pl_w, pl_h, 12 * S);

  // 縦線: 入力レベル。範囲に応じて 1/2/5/10/20 dB 刻み
  raw = v_span / 8;
  step = raw < 1.5 ? 1 : (raw < 3.5 ? 2 : (raw < 7.5 ? 5 : (raw < 15 ? 10 : 20)));
  every = g_w * step / v_span < 30 * S ? 2 : 1;
  font(4);
  first = ceil(v_lo / step - 0.0001);
  n = floor(v_span / step + 0.0001);
  k = 0;
  loop(n + 1,
    db = (first + k) * step;
    db <= v_hi + 0.001 ? (
      x = rnd(xpix(db));
      setc(abs(db) % 10 == 0 ? C_GRID2 : C_GRID, 1);
      gfx_line(x, pl_y + 4 * S, x, g_b + 4 * S, 0);
      (first + k) % every == 0 && x > g_x0 - 4 * S && x < g_x0 + g_w + 4 * S ? (
        setc(C_DIM, 1);
        txt(fmt(db, 0), x - 20 * S, g_b + 8 * S, 40 * S, 13 * S, 1);
      );
    );
    k += 1;
  );

  // 横線: ゲイン。読みやすい刻み(1/2/5 × 10^n)で 5 本前後
  raw = y_span / 5;
  step = 10 ^ floor(log10(raw));
  g = raw / step;
  step = (g < 1.5 ? 1 : (g < 3.5 ? 2 : (g < 7.5 ? 5 : 10))) * step;
  dec = step < 1 ? 1 : 0;
  g = 0;
  while (g <= y_span + 0.0001) (
    y = rnd(ypix(-g));
    setc(g == 0 ? C_GRID2 : C_GRID, 1);
    gfx_line(clip_l, y, pl_x + pl_w - 2 * S, y, 0);
    setc(C_DIM, 1);
    txt(fmt(-g, dec), pl_x + 4 * S, y - 7 * S, g_x0 - pl_x - 12 * S, 14 * S, 2 | 4);
    g += step;
  );
);

// 曲線 b=2 (Attack) / 6 (Release) の折れ線。両端の水平部を含め、グラフの外には出さない。
function curve_path(b th) local(cl op span u k x0 y0 x1 y1 yb yt) (
  cl = cl_of(b); op = op_of(b);
  span = max(op - cl, 0.01);
  cp_load(b);
  yb = ypix(-range_db); yt = ypix(0);
  x0 = xpix(cl); y0 = yb;
  cseg(clip_l, yb, x0, yb, th);
  cseg(xpix(op), yt, clip_r, yt, th);
  k = 0;
  loop(64,
    k += 1;
    u = k / 64;
    x1 = xpix(cl + qx(u, cp_x) * span);
    y1 = ypix(-range_db * (1 - qx(u, cp_y)));
    cseg(x0, y0, x1, y1, th);
    x0 = x1; y0 = y1;
  );
);

function draw_curve(b col th) (
  setc(C_PLOT, 1); curve_path(b, th + 3 * S);
  setc(col, 1); curve_path(b, th);
);

function draw_band() local(k n yt yb h acl rcl asp rsp yn xa xr x1 x2 ax ay rx ry) (
  yt = ypix(0); yb = ypix(-range_db);
  n = max(floor((yb - yt) / (2 * S)), 1);
  h = (yb - yt) / n;
  cp_load(2); ax = cp_x; ay = cp_y;
  cp_load(6); rx = cp_x; ry = cp_y;
  acl = cl_of(2); rcl = cl_of(6);
  asp = max(op_of(2) - acl, 0.01); rsp = max(op_of(6) - rcl, 0.01);
  setc(0xFFFFFF, 0.1);
  k = 0;
  loop(n,
    yn = 1 - (k + 0.5) / n;
    xa = xpix(acl + qx(qu(yn, ay), ax) * asp);
    xr = xpix(rcl + qx(qu(yn, ry), rx) * rsp);
    x1 = max(min(xa, xr), clip_l); x2 = min(max(xa, xr), clip_r);
    x2 - x1 >= 1 ? ( frect(x1, yt + k * h, x2 - x1, h); );
    k += 1;
  );
);

// ハンドル ID: 102/103, 106/107 = Close/Open（ID = 100 + スライダー番号）、
// 152/156 = 曲線の中点（下 1 桁が Attack=2 / Release=6）。位置を h_x, h_y に返す。
// 表示範囲の外なら端に寄せ、h_off に -1/1 を返す。曲線の中点は hf_x, hf_y に曲線内の正規化位置も返す。
function hid(i) ( i == 0 ? 102 : i == 1 ? 103 : i == 2 ? 152 : i == 3 ? 106 : i == 4 ? 107 : 156; );
function id_curve(id) ( id % 10 < 5 ? 2 : 6; );
function hpos(id) local(b cl op span) (
  b = id_curve(id);
  cl = cl_of(b); op = op_of(b);
  span = max(op - cl, 0.01);
  id < 150 ? (
    id == 100 + b ? ( h_x = xpix(cl); h_y = ypix(-range_db); ) : ( h_x = xpix(op); h_y = ypix(0); );
  ) : (
    cp_load(b);
    hf_x = qx(0.5, cp_x); hf_y = qx(0.5, cp_y);
    h_x = xpix(cl + hf_x * span);
    h_y = ypix(-range_db * (1 - hf_y));
  );
  h_off = h_x < g_x0 - 0.5 ? -1 : (h_x > g_x0 + g_w + 0.5 ? 1 : 0);
  h_x = clamp(h_x, g_x0, g_x0 + g_w);
);

function find_handle() local(i id best bd dx dy d) (
  best = 0; bd = hit_r2;
  i = 0;
  loop(ui_sync ? 3 : 6,
    id = hid(i);
    hpos(id);
    dx = mx - h_x; dy = my - h_y; d = dx * dx + dy * dy;
    d < bd ? ( bd = d; best = id; );
    i += 1;
  );
  best;
);

function drag_anchor() (
  drag_mx0 = mx; drag_my0 = my;
  drag_v0 = drag_id < 150 ? slider(drag_id - 100) : slider(cidx(id_curve(drag_id)));
);

// 曲線の中点は対角線に直交する線上だけを動く。ポインターの移動量をその線へ射影して強さ (%) にする。
function drag_handle() local(b kk span dfx dfy) (
  kk = shift ? 0.1 : 1;
  shift != drag_sh ? ( drag_sh = shift; drag_anchor(); ); // Shift の切替時は基準を取り直して値が飛ばないようにする
  drag_id < 150 ? (
    // Attack の Close は Open からの距離 (Range) を、Open 側のハンドルは基準位置を動かす。Range は Close を右へ動かすと縮む。
    set_param(drag_id - 100, drag_v0 + (drag_id == 102 ? -1 : 1) * kk * (mx - drag_mx0) * v_span / g_w);
  ) : (
    b = id_curve(drag_id);
    span = max(op_of(b) - cl_of(b), 0.01);
    dfx = (mx - drag_mx0) * v_span / (g_w * span);
    dfy = range_db < 0.1 ? 0 : -(my - drag_my0) * y_span / (range_db * g_h);
    set_param(cidx(b), drag_v0 + kk * 200 * (dfx - dfy));
  );
);

function reset_curve(b) ( reset_param(cidx(b)); );

function draw_handles() local(i id b col hot r al) (
  i = 0;
  loop(ui_sync ? 3 : 6,
    id = hid(i);
    b = id_curve(id);
    hot = hov_h == id || drag_id == id;
    hpos(id);
    al = h_off ? 0.5 : 1;
    col = ui_sync ? C_SYNC : (b == 2 ? C_ATT : C_REL);
    id >= 150 ? (
      r = (hot ? 10 : 8.5) * S;
      hot ? ( setc(col, 0.2); gfx_circle(h_x, h_y, r + 4.5 * S, 1, 1); );
      setc(C_PLOT, al); gfx_circle(h_x, h_y, r + 2.5 * S, 1, 1);
      setc(col, al); gfx_circle(h_x, h_y, r, 1, 1);
      drag_id != id ? ( setc(C_PLOT, 1); gfx_circle(h_x, h_y, r - 3.4 * S, 1, 1); );
      drag_id != id && !h_off ? ( setc(col, 1); gfx_circle(h_x, h_y, 2.4 * S, 1, 1); );
    ) : (
      r = (hot ? 9.5 : 8) * S;
      hot ? ( setc(col, 0.2); gfx_circle(h_x, h_y, r + 5 * S, 1, 1); );
      setc(C_PLOT, al); gfx_circle(h_x, h_y, r + 2.5 * S, 1, 1);
      setc(col, al); gfx_circle(h_x, h_y, r, 1, 1);
      h_off && drag_id != id ? ( setc(C_PLOT, 1); gfx_circle(h_x, h_y, r - 3.2 * S, 1, 1); );
    );
    i += 1;
  );
);

// 右クリックでグラフ上のハンドルから Close/Open を入力しているとき（欄から入力しているときは除く）
function tip_edit() ( edit_id && !edit_fld && (edit_id == 2 || edit_id == 3 || edit_id == 6 || edit_id == 7); );

function draw_tip() local(p w h x y tw th ed bw nmw vw b id) (
  ed = tip_edit();
  id = ed ? 100 + edit_id : hov_h;
  hpos(id);
  id >= 150 ? (
    b = id_curve(id);
    strcpy(#tipn, "Curve");
    strcpy(#tip, fmt(slider(cidx(b)), 0));
    strcat(#tip, " %");
  ) : (
    p = id - 100;
    strcpy(#tipn, ui_sync ? pget(p, 7) : pget(p, 8));
    strcpy(#tip, pstr(p));
  );
  font(2);
  gfx_measurestr(#tipn, nmw, th);
  gfx_measurestr(#tip, vw, th);
  h = 24 * S;
  bw = ed ? 70 * S : vw;
  w = nmw + bw + 28 * S;
  x = clamp(h_x + 16 * S, pl_x + 4 * S, pl_x + pl_w - w - 4 * S);
  y = clamp(h_y - h - 16 * S, pl_y + 4 * S, pl_b - h - 4 * S);
  setc(C_BG, 1); rrect(x, y, w, h, 7 * S);
  setc(C_DIM, 1); txt(#tipn, x + 10 * S, y, nmw + 4 * S, h, 4);
  ed ? (
    edit_box(x + 16 * S + nmw, y + 3 * S, bw, h - 6 * S);
  ) : (
    setc(C_TEXT, 1); txt(#tip, x + 18 * S + nmw, y, vw + 4 * S, h, 4);
  );
);

// Click a field to type; dragging changes it at 0.05 units per pixel (the curve % at 0.5 per pixel).
// tag: 1 = Attack, 2 = Release, 3 = 中立色の欄（Reduction）。tag 2 は Sync 中は使われないので薄く表示して操作を受けない。
// Range（i = 2, 7）は基準（Open / Close）からの相対ゲインなので、基準の欄と見分けがつく配色と矢印で描く。
function ui_field(i x y w h tag) local(hot id dx dy dis fg bg bd v lw vw nw th ed rng cy) (
  id = 400 + i;
  dis = tag == 2 && ui_sync;
  hot = !dis && mx >= x && mx < x + w && my >= y && my < y + h && (!drag_id || drag_id == id);
  hot ? ( hint_id = i; );
  ldown && hot && edit_id != i ? (
    drag_id = id; drag_mx0 = mx; drag_my0 = my; drag_v0 = slider(i);
    drag_sh = shift; bound_moved = 0;
  );
  drag_id == id && lmb ? (
    dx = mx - drag_mx0; dy = drag_my0 - my;
    abs(dx) + abs(dy) > 2 * S ? bound_moved = 1;
    shift != drag_sh ? (
      drag_sh = shift; drag_mx0 = mx; drag_my0 = my; drag_v0 = slider(i);
      dx = dy = 0;
    );
    // Attack の Range は「−x dB」と表示するので、右へドラッグすると表示値が増える（x が減る）向きにする
    bound_moved ? set_param(i, drag_v0 + (i == 2 ? -1 : 1) * (dx + dy) * (shift ? 0.1 : 1) * (i == 1 ? 0.25 : (pget(i, 3) >= 1 ? 0.5 : 0.05)) / S);
  );
  drag_id == id && !lmb && lmb_prev ? (
    !bound_moved ? ( edit_begin(i); edit_fld = 1; );
    drag_id = 0;
  );
  ed = edit_id == i && edit_fld;
  ed ? (
    edit_box(x, y, w, h);
  ) : (
    tag == 1 ? ( bd = C_YAM3; bg = hot || drag_id == id ? C_YAM2 : C_YAM; fg = C_TEXT; ) : (
    tag == 2 ? ( bd = C_PLOT; bg = C_PLOT; fg = C_BG; ) : (
      bd = C_TRACK; bg = hot || drag_id == id ? C_SLOT : C_BG; fg = C_TEXT; ));
    rng = i == 2 || i == 7;
    tag == 2 && hot ? ( bd = C_GRID2; bg = C_GRID; );
    rng ? (
      hot || drag_id == id ? (
        tag == 1 ? ( bd = C_YAM3; bg = 0xFFEBB5; ) : ( bd = C_GRID2; bg = 0xDDE3F0; );
      ) : (
        tag == 1 ? ( bd = C_YAM3; bg = 0xFFF4D8; ) : ( bd = C_FAINT; bg = 0xEEF1F7; );
      );
      fg = C_TEXT;
    );
    dis ? ( bd = C_TRACK; bg = C_PANEL; fg = C_FAINT; );
    setc(bd, 1); rrect(x, y, w, h, 4 * S);
    setc(bg, 1); rrect(x + S, y + S, w - 2 * S, h - 2 * S, 3 * S);
    strcpy(#bound, pstr(i));
    font(2); setc(fg, 1);
    // 名前を左、値を右に置く
    gfx_measurestr(#bound, vw, th);
    txt(#bound, x, y, w - 5 * S, h, 2 | 4);
    font(4); setc(fg, dis ? 1 : 0.7);
    txt(pget(i, 7), x + 5 * S, y, w - vw - 10 * S, h, 4);
    rng ? (
      gfx_measurestr(pget(i, 7), nw, th);
      cy = y + h * 0.5;
      lw = x + 5 * S + nw + 6 * S;
      setc(fg, dis ? 1 : 0.9);
      i == 2 ? (
        gfx_triangle(lw - 3 * S, cy - 1.8 * S, lw + 3 * S, cy - 1.8 * S, lw, cy + 2.4 * S);
      ) : (
        gfx_triangle(lw - 3 * S, cy + 1.8 * S, lw + 3 * S, cy + 1.8 * S, lw, cy - 2.4 * S);
      );
    );
  );
);

// グラフ下 1 段: 左に Attack、その右に Release、右端（メーターの下）に Reduction（リダクション下限）。
// Attack / Release は Curve / 基準（Attack は Open、Release は Close） / Range の順。
function ui_curve_fields() local(y w h gap tw x0 cw grp cx tag nm rf gp) (
  h = 20 * S; y = pl_b + 12 * S; gap = 10 * S;
  tw = 48 * S; rf = 104 * S; gp = 30 * S;
  cw = ui_w - 2 * mg;
  grp = (cw - rf - 2 * gp) * 0.5;
  w = (grp - tw - 3 * gap) / 3;
  tag = 1;
  loop(2,
    x0 = tag == 1 ? mg : mg + grp + gp;
    nm = tag == 1 ? "ATTACK" : "RELEASE";
    font(4); setc(tag == 1 ? C_YAM3 : (ui_sync ? C_FAINT : C_PLOT), 1);
    txt(nm, x0, y, tw, h, 4);
    cx = x0 + tw + gap;
    ui_field(tag == 1 ? 4 : 8, cx, y, w * 0.85, h, tag);
    cx += w * 0.85 + gap;
    ui_field(tag == 1 ? 3 : 6, cx, y, w * 1.0, h, tag);
    cx += w * 1.0 + gap;
    ui_field(tag == 1 ? 2 : 7, cx, y, w * 1.15, h, tag);
    setc(C_RULE, 1);
    cx = floor(x0 + grp + gp * 0.5) + 0.5; gfx_line(cx, y + 1 * S, cx, y + h - 1 * S, 0);
    tag += 1;
  );
  ui_field(1, mg + cw - rf, y, rf, h, 3);
);

// 検知レベルでの目標ゲイン（dB）。@sample の curve_db と同じ式を GUI 側で評価する。
function gain_at(b lvl) local(cl sp t u) (
  cl = cl_of(b); sp = max(op_of(b) - cl, 0.01);
  t = (lvl - cl) / sp;
  t <= 0 ? ( -range_db ) : (
    t >= 1 ? ( 0 ) : (
      cp_load(b);
      u = qu(t, cp_x);
      -range_db * (1 - qx(u, cp_y));
    );
  );
);

// col を C_PLOT 側へ a の割合で混ぜた不透明色にする（半透明にすると重ね描きで濃くなる図形用）。
function setmix(col a) local(r g b) (
  r = (((col >> 16) & 255) * a + ((C_PLOT >> 16) & 255) * (1 - a)) / 255;
  g = (((col >> 8) & 255) * a + ((C_PLOT >> 8) & 255) * (1 - a)) / 255;
  b = ((col & 255) * a + (C_PLOT & 255) * (1 - a)) / 255;
  gfx_set(r, g, b, 1);
);

// 検知レベルの縦棒。hl（0..1）が高いほど、いま目標ゲインを決めている側として強調する。
// 画面端に近づいたら（範囲外では 0 まで）フェードアウトする。al は全体の濃さ。
function draw_bar(col raw hl al) local(x f a) (
  f = clamp(min(xpix(raw) - g_x0, g_x0 + g_w - xpix(raw)) / (30 * S), 0, 1) * al;
  f > 0.01 ? (
    x = xpix(clamp(raw, v_lo, v_hi));
    a = 0.4 + 0.6 * hl;
    setc(col, 0.14 * hl * f); frect(x - 5 * S, pl_y + 4 * S, 10 * S, g_b - pl_y);
    setc(col, a * f); frect(x - (0.7 + 0.8 * hl) * S, pl_y + 4 * S, (1.4 + 1.6 * hl) * S, g_b - pl_y);
  );
);

// 過去 TN フレームの位置を薄く残す（残像）。i=0 が現在、i が大きいほど古い。w=0 が Attack、1 が Release。
function draw_trail(col w hl) local(i) (
  i = TN - 1;
  loop(TN - 1,
    draw_bar(col, TH[i * 2 + w], hl, 0.35 * (1 - i / TN));
    i -= 1;
  );
);

function draw_markers() (
  draw_trail(C_ATT, 0, ui_hl);
  draw_trail(C_REL, 1, 1 - ui_hl);
  draw_bar(C_ATT, ui_a, ui_hl, 1);
  draw_bar(C_REL, ui_r, 1 - ui_hl, 1);
);

function ui_plot() local(inp) (
  inp = mx >= pl_x && mx < pl_x + pl_w && my >= pl_y && my < pl_b;
  hov_h = (drag_id >= 100 && drag_id < 200) ? drag_id : (
    (inp && !drag_id && (!lmb || ldown)) ? find_handle() : 0);
  hov_h ? ( hint_id = hov_h >= 150 ? 310 : hov_h; );
  ldown && hov_h ? (
    drag_id = hov_h;
    drag_sh = shift;
    (ctrl || is_dbl(hov_h)) ? ( hov_h < 150 ? reset_param(hov_h - 100) : reset_curve(id_curve(hov_h)); );
    drag_anchor();
  );
  rdown && hov_h && hov_h < 150 && edit_id != hov_h - 100 ? edit_begin(hov_h - 100);
  drag_id >= 100 && drag_id < 200 && lmb ? drag_handle();
  hov_h && hov_h < 150 && !lmb && wh != 0 ? ( wheel_param(hov_h - 100, wh); wh = 0; );

  draw_grid();
  ui_sync ? (
    setc(C_REL, 0.35); curve_path(6, 2 * S);
    draw_curve(2, C_SYNC, 5.5 * S);
  ) : (
    draw_band();
    draw_curve(6, C_REL, 5.5 * S);
    draw_curve(2, C_ATT, 5.5 * S);
  );
  draw_markers();
  draw_handles();
  (hov_h || tip_edit()) ? draw_tip();
  ui_curve_fields();
);

// 右端のリダクションメーター。グラフと同じ形で、縦軸（ゲイン）もグラフと同じ位置に合わせる。
function ui_gr() local(x gr y y0 h) (
  x = pl_x + pl_w + mt_gap;
  setc(C_PLOT, 1); rrect(x, pl_y, mt_w, pl_h, 12 * S);
  gr = bypass >= 0.5 ? 0 : gdb;
  y0 = ypix(0);
  y = ypix(clamp(gr, -y_span, 0));
  h = y - y0;
  setc(C_GRID2, 1); gfx_line(x + 4 * S, y0, x + mt_w - 4 * S, y0, 0);
  h >= 1 ? (
    setc(0xFFFFFF, 1);
    rrect(x + 6 * S, y0, mt_w - 12 * S, h, min(5 * S, h * 0.5));
  );
);

KR = 900; // 各つまみの範囲（KR[i*4]..）

function arc_cap(cx cy rm ang w) (
  gfx_circle(cx + sin(ang) * rm, cy - cos(ang) * rm, w * 0.5, 1, 1);
);

// 角度 ±135° に値を割り当てた円形つまみ。bip なら 0 の位置(真上)から値まで弧を引く。
function knob_draw(cx cy rad n bip hot act) local(ang rin rm w a0 a1) (
  ang = (n - 0.5) * 4.71238898038469;
  w = 4 * S;
  rin = rad - w;
  rm = rad - w * 0.5;
  setc(C_TRACK, 1);
  arcw(cx, cy, rin, rad, -2.356194490192345, 2.356194490192345);
  arc_cap(cx, cy, rm, -2.356194490192345, w);
  arc_cap(cx, cy, rm, 2.356194490192345, w);
  a0 = bip ? min(0, ang) : -2.356194490192345;
  a1 = bip ? max(0, ang) : ang;
  setc(act || hot ? C_YAM3 : C_YAM, 1);
  arcw(cx, cy, rin, rad, a0, a1);
  arc_cap(cx, cy, rm, a0, w);
  arc_cap(cx, cy, rm, a1, w);
  setc(C_TEXT, 1); gfx_circle(cx, cy, rin - 2.4 * S, 1, 1);
  setc(C_BG, 1);
  sline(cx + sin(ang) * 2 * S, cy - cos(ang) * 2 * S, cx + sin(ang) * (rin - 5 * S), cy - cos(ang) * (rin - 5 * S), 2.4 * S);
);

function knob_slot(i sx sy sw sh) local(hot act ed ined n cx cy rad vy tw th) (
  ed = edit_id == i;
  ined = ed && mx >= edit_rx && mx < edit_rx + edit_rw && my >= edit_ry && my < edit_ry + edit_rh;
  hot = !ined && (!drag_id || drag_id == i) && mx >= sx && mx < sx + sw && my >= sy && my < sy + sh;
  KR[i * 4] = sx; KR[i * 4 + 1] = sy; KR[i * 4 + 2] = sw; KR[i * 4 + 3] = sh;
  hot ? ( hint_id = i; );
  ldown && hot ? (
    drag_id = i;
    drag_mx0 = mx; drag_my0 = my; drag_sh = shift;
    (ctrl || is_dbl(i)) ? reset_param(i);
    drag_n0 = p_norm(i, slider(i));
  );
  rdown && hot && !ed ? edit_begin(i);
  drag_id == i && lmb ? (
    shift != drag_sh ? ( drag_sh = shift; drag_mx0 = mx; drag_my0 = my; drag_n0 = p_norm(i, slider(i)); );
    set_param(i, p_from_norm(i, drag_n0 + (shift ? 0.1 : 1) * ((drag_my0 - my) + (mx - drag_mx0) * 0.5) / (150 * S)));
  );
  hot && wh != 0 && !drag_id ? ( wheel_param(i, wh); wh = 0; );

  act = drag_id == i;
  n = p_norm(i, slider(i));
  hot || act ? ( setc(C_SLOT, 1); rrect(sx + 1 * S, sy, sw - 2 * S, sh - 4 * S, 8 * S); );
  font(7); setc(C_TEXT, 1);
  txt(pget(i, 7), sx, sy + 2 * S, sw, 12 * S, 1 | 4);
  rad = 13 * S; cx = sx + sw * 0.5; cy = sy + 16 * S + rad;
  knob_draw(cx, cy, rad, n, pget(i, 10), hot, act);
  vy = sy + 16 * S + 2 * rad + 3 * S;
  ed ? edit_box(sx + 3 * S, vy, sw - 6 * S, 15 * S) : (
    strcpy(#kv, fmt(slider(i), pget(i, 5)));
    strcat(#kv, " ");
    strcat(#kv, pget(i, 6));
    font(1); setc(act || hot ? C_TEXT : C_DIM, 1);
    txt(#kv, sx, vy, sw, 15 * S, 1 | 4);
  );
);

function knob_group(title col p0 p1 x) local(k p tw th) (
  font(4); setc(col, 1);
  gfx_measurestr(title, tw, th);
  txt(title, x + 2 * S, kg_y, tw + 8 * S, 12 * S, 4);
  setc(C_RULE, 1);
  gfx_line(x + tw + 12 * S, kg_y + 6 * S, x + 2 * kw - 2 * S, kg_y + 6 * S, 0);
  k = 0;
  loop(2,
    p = k == 0 ? p0 : p1;
    knob_slot(p, x + k * kw, kg_y + 14 * S, kw, 62 * S);
    k += 1;
  );
  x + 2 * kw + gg;
);

// RMS Control の見出し。クリックで開閉する（開閉状態は rms_open に保存される）。
function ui_rms_head() local(hot tw th cx cy) (
  font(6);
  gfx_measurestr("RMS CONTROL", tw, th);
  hot = !drag_id && mx >= mg && mx < mg + tw + 34 * S && my >= kz_y && my < kz_y + 18 * S;
  hot ? ( hint_id = 305; );
  ldown && hot ? ( slider(16) = rms_on ? 0 : 1; notify(16); rms_on = !rms_on; );
  cx = mg + 9 * S; cy = kz_y + 9 * S;
  setc(hot ? C_TEXT : C_DIM, 1);
  rms_on ? (
    gfx_triangle(cx - 4.5 * S, cy - 2.5 * S, cx + 4.5 * S, cy - 2.5 * S, cx, cy + 3.5 * S);
  ) : (
    gfx_triangle(cx - 2.5 * S, cy - 4.5 * S, cx - 2.5 * S, cy + 4.5 * S, cx + 3.5 * S, cy);
  );
  setc(C_TEXT, 1);
  txt("RMS CONTROL", mg + 22 * S, kz_y, tw + 8 * S, 18 * S, 4);
  setc(C_RULE, 1);
  gfx_line(mg + 30 * S + tw, kz_y + 9 * S, ui_w - mg, kz_y + 9 * S, 0);
);

function ui_knobs() local(x) (
  ui_rms_head();
  rms_on ? (
    x = mg;
    x = knob_group("DETECTION", C_DIM, 9, 10, x);
    x = knob_group("ATTACK", C_YAM3, 13, 11, x);
    x = knob_group("RELEASE", C_TEXT, 14, 12, x);
  );
);

function leg_item(x y col al label w) (
  setc(col, al); gfx_circle(x + 5 * S, y + 8 * S, 4.5 * S, 1, 1);
  font(5); setc(C_BG, al > 0.5 ? 1 : 0.6);
  txt(label, x + 15 * S, y, w + 4 * S, 16 * S, 4);
);

SY = 1000; // SYNC ボタンの範囲（SY[0..3]）
function sync_pill(x y w h) local(hot) (
  hot = !drag_id && mx >= x && mx < x + w && my >= y && my < y + h;
  SY[0] = x; SY[1] = y; SY[2] = w; SY[3] = h;
  hot ? ( hint_id = 300; );
  ldown && hot ? set_sync(!ui_sync);
  ui_sync ? (
    setc(hot ? C_YAM2 : C_YAM, 1); rrect(x, y, w, h, h * 0.5);
  ) : (
    setc(C_TEXT, 1); rrect(x, y, w, h, h * 0.5);
    setc(hot ? C_SLOT : C_BG, 1); rrect(x + 2 * S, y + 2 * S, w - 4 * S, h - 4 * S, h * 0.5 - 2 * S);
  );
  setc(ui_sync ? C_TEXT : C_FAINT, 1); gfx_circle(x + h * 0.5 + 1 * S, y + h * 0.5, 3.8 * S, 1, 1);
  font(6); setc(C_TEXT, 1);
  txt("SYNC", x + h, y, w - h - 8 * S, h, 1 | 4);
);

BY = 1010;
function bypass_pill(x y w h) local(hot on) (
  on = bypass >= 0.5;
  hot = !drag_id && mx >= x && mx < x + w && my >= y && my < y + h;
  hot ? ( hint_id = 301; );
  ldown && hot ? ( slider(15) = on ? 0 : 1; notify(15); on = !on; );
  on ? (
    setc(hot ? C_YAM2 : C_YAM, 1); rrect(x, y, w, h, h * 0.5);
  ) : (
    setc(C_TEXT, 1); rrect(x, y, w, h, h * 0.5);
    setc(hot ? C_SLOT : C_BG, 1); rrect(x + 2 * S, y + 2 * S, w - 4 * S, h - 4 * S, h * 0.5 - 2 * S);
  );
  setc(on ? C_TEXT : C_FAINT, 1); gfx_circle(x + h * 0.5 + 1 * S, y + h * 0.5, 3.8 * S, 1, 1);
  font(6); setc(C_TEXT, 1);
  txt("BYPASS", x + h, y, w - h - 8 * S, h, 1 | 4);
);

function ui_header() local(x tw th w1 w2 hh lw) (
  font(3); setc(C_TEXT, 1);
  gfx_measurestr("AZMbeziExp", tw, th);
  txt("AZMbeziExp", mg, 15 * S, tw + 4 * S, 28 * S, 4);
  strcpy(#lg1, ui_sync ? "Attack = Release" : "Attack");
  strcpy(#lg2, ui_sync ? "Release (kept)" : "Release");
  font(5);
  gfx_measurestr(#lg1, w1, hh);
  gfx_measurestr(#lg2, w2, hh);
  x = mg + tw + 30 * S;
  lw = 14 * S + 15 * S + w1 + 16 * S + 15 * S + w2 + 14 * S;
  setc(C_PLOT, 1); rrect(x, 18 * S, lw, 26 * S, 13 * S);
  ui_sync ? (
    leg_item(x + 14 * S, 23 * S, C_SYNC, 1, #lg1, w1);
    leg_item(x + 14 * S + 15 * S + w1 + 16 * S, 23 * S, C_REL, 0.45, #lg2, w2);
  ) : (
    leg_item(x + 14 * S, 23 * S, C_ATT, 1, #lg1, w1);
    leg_item(x + 14 * S + 15 * S + w1 + 16 * S, 23 * S, C_REL, 1, #lg2, w2);
  );
  bypass_pill(ui_w - mg - 104 * S, 18 * S, 104 * S, 26 * S);
  sync_pill(ui_w - mg - 104 * S - 8 * S - 92 * S, 18 * S, 92 * S, 26 * S);
);

function ui_footer() local(p x w th tw) (
  setc(C_PANEL, 1); rrect(mg, ft_y, ui_w - 2 * mg, ft_h, 7 * S);
  x = mg + 12 * S;
  font(2);
  edit_id ? (
    setc(C_TEXT, 1);
    txt("Type a value.   Enter: apply     Esc: cancel     Click elsewhere: apply", x, ft_y, ui_w, ft_h, 4);
  ) : (
    hint_id == 310 ? (
      setc(C_TEXT, 1); txt("Curve point", x, ft_y, 90 * S, ft_h, 4);
      setc(C_DIM, 1);
      txt("Drag along the diagonal to bend the curve (+ opens late, - opens early). Double-click: reset the curve", x + 80 * S, ft_y, ui_w, ft_h, 4);
    ) : hint_id == 301 ? (
      setc(C_TEXT, 1); txt("Bypass", x, ft_y, 60 * S, ft_h, 4);
      setc(C_DIM, 1);
      txt("Pass the input through unprocessed. Detection keeps running.", x + 46 * S, ft_y, ui_w, ft_h, 4);
    ) : hint_id == 300 ? (
      setc(C_TEXT, 1); txt("Sync", x, ft_y, 60 * S, ft_h, 4);
      setc(C_DIM, 1);
      txt("Release uses Attack's curve. The stored Release settings are kept.", x + 38 * S, ft_y, ui_w, ft_h, 4);
    ) : hint_id == 305 ? (
      setc(C_TEXT, 1); txt("RMS Control", x, ft_y, 90 * S, ft_h, 4);
      setc(C_DIM, 1);
      txt("Click to show or hide detection, RMS ratio and smoothing time.", x + 76 * S, ft_y, ui_w, ft_h, 4);
    ) : (
      hint_id ? (
        p = hint_id >= 100 ? hint_id - 100 : hint_id;
        strcpy(#ft, pget(p, 8));
        strcat(#ft, "  ");
        strcat(#ft, pstr(p));
        gfx_measurestr(#ft, tw, th);
        setc(C_TEXT, 1); txt(#ft, x, ft_y, tw + 4 * S, ft_h, 4);
        setc(C_DIM, 1); txt(pget(p, 9), x + tw + 18 * S, ft_y, ui_w, ft_h, 4);
      ) : (
        setc(C_DIM, 1);
        txt("Drag the handles or fields to shape the curves.   Right-click: type a value   Double-click: reset   Shift: fine", x, ft_y, ui_w, ft_h, 4);
      );
    );
  );
);

function ui_frame() (
  ui_begin();
  setc(C_BG, 1); gfx_rect(0, 0, ui_w, ui_h);
  ui_header();
  ui_plot();
  ui_gr();
  ui_knobs();
  ui_footer();
  ui_end();
);

@slider
on_slider();

@block
// GUI で変更されたパラメーターを、オーディオスレッド側で @slider と同じ処理に通す
ui_dirty ? ( ui_dirty = 0; on_slider(); );

@sample
// ステレオリンク（L/R の大きい方）で検出
a = max(abs(spl0), abs(spl1));

// Peak is instantaneous; RMS has only its averaging window.
msq = max(msq + rms_k * (a * a - msq), floor_pow);
rms_raw = sqrt(2 * msq);
pk_lin = a;
rms_lin = rms_raw * rms_gain;
a_lin = max(pk_lin * (1 - a_mix) + rms_lin * a_mix, floor_amp);
r_lin = max(pk_lin * (1 - r_mix) + rms_lin * r_mix, floor_amp);
dir_a_f += (a_lin - dir_a_f) * dir_k;
dir_r_f += (r_lin - dir_r_f) * dir_k;

// Attack wins if both conditions are true; neither leaves direction unchanged.
!gain_init ? (
  dir_a_f > prev_dir_a ? ( dir_up = 1; ) : dir_r_f < prev_dir_r ? ( dir_up = 0; );
);
prev_dir_a = dir_a_f;
prev_dir_r = dir_r_f;
lin = dir_up ? a_lin : r_lin;
lvl_db = log(lin) * 8.685889638065037;
m_a = max(m_a, a_lin);
m_r = max(m_r, r_lin);
m_up = dir_up;

tgt = dir_up ? curve_db(lvl_db, a_close, a_span, a_x1, a_y1, range_db)
             : curve_db(lvl_db, e_close, r_span, r_x1, r_y1, range_db);
gain_init ? ( gdb = tgt; gain_init = 0; ) : (
  gdb < tgt ? ( gdb = min(tgt, gdb + (tgt - gdb + eps_db) * k_open); )
             : gdb > tgt ? ( gdb = max(tgt, gdb + (tgt - gdb - eps_db) * k_close); );
);

gain = exp(gdb * 0.11512925464970229);
// Bypass crossfades over ~5 ms to avoid clicks; detection and gdb keep running.
byp_m += ((bypass >= 0.5) - byp_m) * byp_k;
gain += (1 - gain) * byp_m;
spl0 *= gain;
spl1 *= gain;

@gfx 940 520
ui_w = gfx_w * SS; ui_h = gfx_h * SS;
ui_w != buf_w || ui_h != buf_h ? ( gfx_setimgdim(0, ui_w, ui_h); buf_w = ui_w; buf_h = ui_h; );
gfx_dest = 0;
ui_frame();
gfx_dest = -1;
gfx_a = 1; gfx_mode = 0; gfx_x = gfx_y = 0;
gfx_blit(0, 1 / SS, 0);
